<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_send_daily_price_report" model="ir.cron">
            <field name="name">Rapport Journalier des Prix (WhatsApp)</field>
            <field name="model_id" ref="model_achat_article_price"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_daily_price_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <!-- 20:00:00 Local time, usually 19:00:00 UTC -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=19, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
