<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb Report Template -->
    <template id="report_daily_price_changes_document">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <h2 class="text-center mt-4 mb-4">Rapport Journalier des Changements de Prix</h2>
                    <h4 class="text-center mb-5">
                        <span t-esc="report_date"/>
                    </h4>

                    <div class="row">
                        <t t-foreach="changes" t-as="c">
                            <div class="col-12 mb-5" style="page-break-inside: avoid;">
                                <div class="card" style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden;">
                                    <div class="card-header" style="background-color: #f8f9fa; border-bottom: 2px solid #1f77b4; padding: 15px;">
                                        <h4 class="mb-0" style="color: #333;">
                                            <strong><span t-esc="c['article']"/></strong>
                                            <span style="font-size: 0.8em; color: #666; float: right;">
                                                <t t-if="c['trend'] == 'up'">
                                                    <span style="color: red;">🔺 Hausse: </span>
                                                </t>
                                                <t t-if="c['trend'] == 'down'">
                                                    <span style="color: green;">🔻 Baisse: </span>
                                                </t>
                                                <span t-esc="'%.2f' % c['old_price']"/> ➡️ <strong><span t-esc="'%.2f' % c['new_price']"/> <span t-esc="c['currency']"/></strong>
                                            </span>
                                        </h4>
                                    </div>
                                    <div class="card-body" style="padding: 15px;">
                                        <div class="row mb-3">
                                            <div class="col-6">
                                                <p class="mb-1"><strong>Fournisseur:</strong> <span t-esc="c['fournisseur']"/></p>
                                                <p class="mb-1"><strong>Origine:</strong> <span t-esc="c['origine']"/></p>
                                            </div>
                                            <div class="col-6">
                                                <p class="mb-1"><strong>Crop:</strong> <span t-esc="c['crop']"/></p>
                                                <p class="mb-1"><strong>Incoterm:</strong> <span t-esc="c['incoterm']"/></p>
                                            </div>
                                        </div>
                                        <t t-if="c.get('graph_b64')">
                                            <div class="text-center mt-3">
                                                <img t-att-src="'data:image/png;base64,' + c['graph_b64']" style="max-width: 100%; height: auto; border: 1px solid #eee; border-radius: 4px;"/>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="text-center mt-3" style="color: #999; font-style: italic;">
                                                <p>Pas d'historique suffisant pour afficher le graphique.</p>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                
                <div class="footer">
                    <div class="text-center" style="font-size: 12px; color: #888; border-top: 1px solid #eee; padding-top: 10px;">
                        Page <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_daily_price_changes">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="achat.report_daily_price_changes_document"/>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_daily_price_changes" model="ir.actions.report">
        <field name="name">Rapport Journalier Prix</field>
        <field name="model">achat.article.price</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">achat.report_daily_price_changes_document</field>
        <field name="report_file">achat.report_daily_price_changes_document</field>
        <field name="print_report_name">'Rapport_Prix'</field>
    </record>
</odoo>
