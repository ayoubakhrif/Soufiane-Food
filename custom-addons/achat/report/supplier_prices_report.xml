<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template QWeb pour les prix sélectionnés -->
    <template id="report_supplier_prices_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center mt-4 mb-4" style="color: #1f77b4;">Prix Fournisseurs (Sélection)</h2>
                    
                    <table class="table table-sm table-striped mt-4" style="border: 1px solid #ddd;">
                        <thead style="background-color: #f8f9fa; border-bottom: 2px solid #1f77b4;">
                            <tr>
                                <th>Date</th>
                                <th>Article</th>
                                <th>Fournisseur</th>
                                <th>Origine</th>
                                <th>Crop</th>
                                <th>Détails</th>
                                <th>Packaging</th>
                                <th>Taille CTN</th>
                                <th>Incoterm</th>
                                <th class="text-right">Prix</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td><span t-field="o.date" t-options='{"widget": "date"}'/></td>
                                    <td><strong><span t-field="o.article_id.name"/></strong></td>
                                    <td><span t-field="o.supplier_id.name"/></td>
                                    <td><span t-field="o.origin_id.name"/></td>
                                    <td>
                                        <t t-if="o.crop == 'new_crop'">New Crop</t>
                                        <t t-if="o.crop == 'old_crop'">Old Crop</t>
                                    </td>
                                    <td><span t-field="o.detail_id.name"/></td>
                                    <td><span t-field="o.packaging_id.name"/></td>
                                    <td><span t-field="o.container_size_id.name"/></td>
                                    <td><span t-field="o.incoterm"/></td>
                                    <td class="text-right" style="white-space: nowrap;">
                                        <strong><span t-field="o.price" t-options='{"widget": "float", "precision": 2}'/> <span t-field="o.currency_id.name"/></strong>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- Action Report pour le modèle achat.article.price -->
    <record id="action_report_supplier_prices_selected" model="ir.actions.report">
        <field name="name">Rapport Prix Sélectionnés</field>
        <field name="model">achat.article.price</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">achat.report_supplier_prices_document</field>
        <field name="report_file">achat.report_supplier_prices_document</field>
        <field name="binding_model_id" ref="model_achat_article_price"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
