<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_achat_ai_template_form" model="ir.ui.view">
        <field name="name">achat.ai.template.form</field>
        <field name="model">achat.ai.template</field>
        <field name="arch" type="xml">
            <form string="Modèle IA">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du modèle..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Ciblage">
                            <field name="document_type"/>
                            <field name="supplier_id" options="{'no_create': True}"/>
                            <field name="ste_id" options="{'no_create': True}"/>
                            <field name="origin_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Instructions">
                            <field name="instruction_filename" invisible="1"/>
                            <field name="instruction_file" filename="instruction_filename" widget="binary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Instructions Textuelles (Prompt)">
                            <field name="instructions" widget="text" placeholder="Ajoutez ici vos instructions spécifiques pour l'IA..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_achat_ai_template_tree" model="ir.ui.view">
        <field name="name">achat.ai.template.tree</field>
        <field name="model">achat.ai.template</field>
        <field name="arch" type="xml">
            <tree string="Modèles IA">
                <field name="name"/>
                <field name="document_type"/>
                <field name="supplier_id"/>
                <field name="ste_id"/>
                <field name="origin_id"/>
            </tree>
        </field>
    </record>

    <record id="action_achat_ai_template" model="ir.actions.act_window">
        <field name="name">Modèles d'Extraction IA</field>
        <field name="res_model">achat.ai.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau Modèle IA
            </p>
            <p>
                Définissez des modèles d'extraction pour aider l'IA à analyser les documents selon leur origine ou fournisseur.
            </p>
        </field>
    </record>

    <menuitem id="menu_achat_ai_template"
              name="Modèles d'Extraction IA"
              parent="achat.menu_achat_data"
              action="action_achat_ai_template"
              sequence="100"/>

    <!-- Inherit Logistique Supplier Form to add AI Template Button -->
    <record id="view_logistique_supplier_form_inherit_ai" model="ir.ui.view">
        <field name="name">logistique.supplier.form.inherit.ai</field>
        <field name="model">logistique.supplier</field>
        <field name="inherit_id" ref="logistique.view_logistique_supplier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="%(action_achat_ai_template)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-cogs"
                            context="{'search_default_supplier_id': id, 'default_supplier_id': id}">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Modèles IA</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Inherit Logistique Ste Form to add AI Template Button -->
    <record id="view_logistique_ste_form_inherit_ai" model="ir.ui.view">
        <field name="name">logistique.ste.form.inherit.ai</field>
        <field name="model">logistique.ste</field>
        <field name="inherit_id" ref="logistique.view_logistique_ste_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="%(action_achat_ai_template)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-cogs"
                            context="{'search_default_ste_id': id, 'default_ste_id': id}">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Modèles IA</span>
                        </div>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Inherit Achat Origin Form to add AI Template Button -->
    <record id="view_achat_origin_form_inherit_ai" model="ir.ui.view">
        <field name="name">achat.origin.form.inherit.ai</field>
        <field name="model">achat.origin</field>
        <field name="inherit_id" ref="achat.view_achat_origin_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_achat_ai_template)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-cogs"
                        context="{'search_default_origin_id': id, 'default_origin_id': id}">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Modèles IA</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
