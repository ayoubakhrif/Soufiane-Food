<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Level Menu (If generic Purchase module usually exists, we might need a parent. 
         But since this is custom, we'll create a Root or attach to existing Purchase? 
         User didn't specify, but "New Purchase Module" suggests a new root or Main Menu item.) -->
    
    <menuitem id="menu_achat_root"
              name="Achat"
              web_icon="achat,static/description/icon.png"
              sequence="10"/>

    <menuitem id="menu_achat_dossiers"
              name="Dossiers"
              parent="menu_achat_root"
              action="action_purchase_entry"
              sequence="1"/>

    <menuitem id="menu_achat_contracts"
              name="Contrats"
              parent="menu_achat_root"
              action="action_achat_contract"
              groups="achat.group_purchase_manager,achat.group_purchase_admin,achat.group_achat_article_correcteur"
              sequence="5"/>

    <menuitem id="menu_achat_contract_advances"
              name="Avances sur Contrat"
              parent="menu_achat_root"
              action="action_achat_contract_advance"
              groups="achat.group_purchase_manager,achat.group_purchase_admin"
              sequence="6"/>

    <!-- Operational Menus -->
    <menuitem id="menu_achat_dossiers_to_exit"
              name="Dossiers à Sortir"
              parent="menu_achat_root"
              action="action_achat_dossiers_to_exit_window"
              sequence="7"/>

    <menuitem id="menu_achat_tanger_med"
              name="Tanger Med"
              parent="menu_achat_root"
              action="action_achat_tanger_med"
              sequence="8"/>

    <menuitem id="menu_achat_onicl"
              name="Onicl"
              parent="menu_achat_root"
              action="action_achat_onicl"
              sequence="9"/>


    <!-- Data Menu (Moved from Logistique) -->
    <menuitem id="menu_achat_data"
              name="Données"
              parent="menu_achat_root"
              sequence="100"/>

    <menuitem id="menu_achat_ste"
              name="Sociétés"
              parent="menu_achat_data"
              action="logistique.action_logistique_ste"
              sequence="10"/>

    <menuitem id="menu_achat_supplier"
              name="Suppliers"
              parent="menu_achat_data"
              action="logistique.action_logistique_supplier"
              sequence="20"/>

    <menuitem id="menu_achat_article"
              name="Articles (Logistique)"
              parent="menu_achat_data"
              action="logistique.action_logistique_article"
              sequence="30"/>

    <menuitem id="menu_achat_article_achat"
              name="Article Achat"
              parent="menu_achat_data"
              action="action_achat_article"
              sequence="35"/>

    <menuitem id="menu_achat_shipping"
              name="Shipping Companies"
              parent="menu_achat_data"
              action="logistique.action_logistique_shipping"
              sequence="40"/>

    <menuitem id="menu_achat_origin"
              name="Origins"
              parent="menu_achat_data"
              action="action_achat_origin"
              sequence="50"/>

     <menuitem id="menu_achat_prices"
          name="Supplier Prices"
          parent="menu_achat_root"
          action="action_achat_article_price"
          sequence="20"/>

    <menuitem id="menu_achat_document_followup"
              name="Suivi Documents"
              parent="menu_achat_root" 
              action="achat.action_achat_document_followup"
              sequence="30"
              groups="achat.group_purchase_user,achat.group_purchase_manager"/>

    <menuitem id="menu_achat_document_config"
              name="Configuration Documents"
              parent="menu_achat_data"
              action="logistique.action_document_config"
              sequence="90"/>

</odoo>
