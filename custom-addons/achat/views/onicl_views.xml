<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom Tree View for ONICL Dossiers -->
    <record id="view_achat_onicl_tree" model="ir.ui.view">
        <field name="name">achat.onicl.tree</field>
        <field name="model">logistique.entry</field>
        <field name="arch" type="xml">
            <tree string="Dossiers ONICL" 
                  create="false" delete="false"
                  default_order="onicl_days_to_eta asc"
                  decoration-danger="onicl_days_to_eta &lt;= 5"
                  decoration-warning="onicl_days_to_eta &gt; 5 and onicl_days_to_eta &lt;= 10"
                  decoration-info="onicl_days_to_eta &gt; 10">
                <field name="dossier_id" invisible="1"/>
                <field name="ste_id"/>
                <field name="supplier_id"/>
                <field name="achat_article_id"/>
                <field name="eta"/>
                <field name="onicl_days_to_eta" decoration-bf="1"/>
                <field name="port_status" widget="badge" decoration-success="port_status == 'exited'" decoration-info="port_status == 'on_port'"/>
                <field name="purchase_state" widget="badge" decoration-info="purchase_state == 'initial'" decoration-success="purchase_state == 'confirmed'" decoration-muted="purchase_state == 'closed'"/>
            </tree>
        </field>
    </record>

    <!-- Custom Form View for ONICL Dossiers -->
    <record id="view_achat_onicl_form" model="ir.ui.view">
        <field name="name">achat.onicl.form</field>
        <field name="model">logistique.entry</field>
        <field name="arch" type="xml">
            <form string="Dossier ONICL">
                <header>
                    <button name="action_onicl_send_ricpc" string="Envoyer Demande RICPC" type="object" class="oe_highlight" invisible="onicl_state not in ('new', 'ricpc_error')"/>
                    <button name="action_onicl_approve" string="Approuver" type="object" class="btn-success" invisible="onicl_state != 'ricpc_sent'"/>
                    <button name="action_onicl_set_error" string="Signaler Erreur" type="object" class="btn-danger" invisible="onicl_state != 'ricpc_sent'"/>
                    <button name="action_onicl_enter" string="Saisir sur système ONICL" type="object" class="oe_highlight" invisible="onicl_state != 'ricpc_approved'"/>
                    <button name="action_onicl_validate" string="Valider" type="object" class="btn-success" invisible="onicl_state != 'onicl_entered'"/>
                    <button name="action_onicl_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="onicl_state != 'validated'"/>
                    <button name="action_onicl_validate_portnet" string="Valider sur Portnet" type="object" class="btn-success" invisible="onicl_state != 'confirmed'"/>
                    
                    <!-- Admin clickable statusbar -->
                    <field name="onicl_state" widget="statusbar" statusbar_visible="new,ricpc_sent,ricpc_approved,onicl_entered,validated,confirmed,portnet_validated" options="{'clickable': '1'}" groups="achat.group_purchase_admin"/>
                    <field name="onicl_state" widget="statusbar" statusbar_visible="new,ricpc_sent,ricpc_approved,onicl_entered,validated,confirmed,portnet_validated" groups="!achat.group_purchase_admin"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="bl_number" placeholder="BL Number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Principales">
                            <field name="supplier_id" readonly="1"/>
                            <field name="achat_article_id" readonly="1"/>
                            <field name="ste_id" readonly="1"/>
                            <field name="contract_id" readonly="1"/>
                            <field name="invoice_number" readonly="1"/>
                        </group>
                        <group string="Documents ONICL">
                            <field name="onicl_pdf_name" invisible="1"/>
                            <field name="onicl_pdf" filename="onicl_pdf_name" widget="binary"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Dedicated Search View for ONICL -->
    <record id="view_achat_onicl_search" model="ir.ui.view">
        <field name="name">achat.onicl.search</field>
        <field name="model">logistique.entry</field>
        <field name="arch" type="xml">
            <search string="Dossiers ONICL">
                <field name="bl_number"/>
                <field name="supplier_id"/>
                <field name="ste_id"/>
                <field name="achat_article_id"/>

                <group expand="0" string="Group By">
                    <filter string="Fournisseur" name="group_by_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Société" name="group_by_ste" context="{'group_by': 'ste_id'}"/>
                    <filter string="Article" name="group_by_article" context="{'group_by': 'achat_article_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for ONICL -->
    <record id="action_achat_onicl" model="ir.actions.act_window">
        <field name="name">Dossiers ONICL</field>
        <field name="res_model">logistique.entry</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_onicl_applicable', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_achat_onicl_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_achat_onicl_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_achat_onicl_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun dossier ONICL actif avec une ETA dans les 15 prochains jours.
            </p>
        </field>
    </record>

</odoo>
