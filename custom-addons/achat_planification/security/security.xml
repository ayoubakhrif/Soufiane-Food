<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_achat_planification">
            <field name="name">Planification Achats</field>
            <field name="description">Droits d'accès pour le module de planification des achats.</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_achat_planification_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_achat_planification"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Peut voir et gérer les dossiers d'achats.</field>
        </record>

        <record id="group_achat_planification_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_achat_planification"/>
            <field name="implied_ids" eval="[(4, ref('group_achat_planification_user'))]"/>
            <field name="comment">A un accès complet, y compris à la configuration du budget.</field>
        </record>
    </data>
</odoo>
