<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_audit" model="ir.module.category">
            <field name="name">Audit</field>
            <field name="description">Gestion des audits de factures</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_audit_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_audit"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_audit_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_audit"/>
            <field name="implied_ids" eval="[(4, ref('group_audit_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
