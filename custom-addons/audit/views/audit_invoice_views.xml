<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_audit_invoice_tree" model="ir.ui.view">
            <name>audit.invoice.tree</name>
            <model>audit.invoice</model>
            <arch type="xml">
                <tree decoration-info="state == 'draft'" decoration-success="state == 'extracted'">
                    <field name="name"/>
                    <field name="supplier"/>
                    <field name="invoice_number"/>
                    <field name="invoice_date"/>
                    <field name="state"/>
                    <field name="create_date" string="Date Création"/>
                </tree>
            </arch>
        </record>

        <!-- Form View -->
        <record id="view_audit_invoice_form" model="ir.ui.view">
            <name>audit.invoice.form</name>
            <model>audit.invoice</model>
            <arch type="xml">
                <form>
                    <header>
                        <button name="action_extract_ai" string="Extraire par IA" type="object" class="oe_highlight" icon="fa-magic" attrs="{'invisible': [('invoice_pdf', '=', False)]}"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Informations Facture">
                                <field name="supplier" placeholder="Nom du fournisseur..."/>
                                <field name="invoice_number" placeholder="N° de facture..."/>
                                <field name="invoice_date"/>
                            </group>
                            <group string="Document PDF">
                                <field name="invoice_pdf" filename="invoice_filename" widget="pdf_viewer"/>
                                <field name="invoice_filename" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </arch>
        </record>

        <!-- Action -->
        <record id="action_audit_invoice" model="ir.actions.act_window">
            <name>Audit Factures</name>
            <res_model>audit.invoice</res_model>
            <view_mode>tree,form</view_mode>
            <help type="html">
                <p class="o_view_nocontent_smiling_face">
                    Uploadez une facture PDF et laissez l'IA remplir les champs pour vous !
                </p>
            </help>
        </record>
    </data>
</odoo>
