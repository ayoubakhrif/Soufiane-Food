<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_audit_invoice_tree" model="ir.ui.view">
        <field name="name">audit.invoice.tree</field>
        <field name="model">audit.invoice</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'extracted'">
                <field name="name"/>
                <field name="supplier"/>
                <field name="invoice_number"/>
                <field name="invoice_date"/>
                <field name="amount_untaxed" sum="Total HT"/>
                <field name="state" widget="badge"/>
                <field name="create_date" string="Date Création"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_audit_invoice_form" model="ir.ui.view">
        <field name="name">audit.invoice.form</field>
        <field name="model">audit.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_extract_ai" string="Extraire par IA" type="object" class="oe_highlight" icon="fa-magic" invisible="not invoice_pdf"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Facture">
                            <field name="supplier" placeholder="Nom du fournisseur..."/>
                            <field name="invoice_number" placeholder="N° de facture..."/>
                            <field name="invoice_date"/>
                            <field name="amount_untaxed"/>
                        </group>
                        <group string="Document PDF">
                            <field name="invoice_pdf" filename="invoice_filename" widget="pdf_viewer"/>
                            <field name="invoice_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_audit_invoice" model="ir.actions.act_window">
        <field name="name">Audit Factures</field>
        <field name="res_model">audit.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Uploadez une facture PDF et laissez l'IA remplir les champs pour vous !
            </p>
        </field>
    </record>
</odoo>
