<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for discount references -->
    <record id="seq_casa_stock_discount" model="ir.sequence">
        <field name="name">Réduction Stock Casa</field>
        <field name="code">casa.stock.discount</field>
        <field name="prefix">RED/</field>
        <field name="padding">4</field>
    </record>

    <!-- Tree View -->
    <record id="view_casa_stock_discount_tree" model="ir.ui.view">
        <field name="name">casa.stock.discount.tree</field>
        <field name="model">casa.stock.discount</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancel'" decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="client_id"/>
                <field name="date"/>
                <field name="discount_type"/>
                <field name="total_before_discount" sum="Total Avant"/>
                <field name="total_discount" sum="Total Réduction"/>
                <field name="total_after_discount" sum="Total Après"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_casa_stock_discount_form" model="ir.ui.view">
        <field name="name">casa.stock.discount.form</field>
        <field name="model">casa.stock.discount</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Annuler" type="object"
                            invisible="state != 'done'"/>
                    <button name="action_draft" string="Remettre en Brouillon" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <field name="state" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="client_id" readonly="1"/>
                            <field name="driver_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="discount_type" readonly="state != 'draft'"/>
                            <field name="distribution_type" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="global_discount_value" readonly="state != 'draft'"
                                   invisible="distribution_type == 'manual'"/>
                        </group>
                        <group>
                            <button name="action_distribute" string="Distribuer" type="object"
                                    class="oe_highlight" icon="fa-share-alt"
                                    invisible="state != 'draft' or distribution_type == 'manual'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes de Sorties" name="discount_lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <tree editable="bottom">
                                    <field name="exit_id" readonly="1" force_save="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="qty" readonly="1"/>
                                    <field name="weight" readonly="1"/>
                                    <field name="tonnage" readonly="1"/>
                                    <field name="price_sale" readonly="1" string="Prix Vente Initial"/>
                                    <field name="initial_amount" readonly="1"/>
                                    <field name="discount_value"
                                           string="Réduction"/>
                                    <field name="discount_amount" readonly="1"/>
                                    <field name="final_amount" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="comment" placeholder="Commentaires..."/>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_before_discount" widget="monetary"
                               options="{'currency_field': False}"/>
                        <field name="total_discount" widget="monetary"
                               options="{'currency_field': False}" class="oe_subtotal_footer_separator"/>
                        <field name="total_after_discount" widget="monetary"
                               options="{'currency_field': False}" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_casa_stock_discount_search" model="ir.ui.view">
        <field name="name">casa.stock.discount.search</field>
        <field name="model">casa.stock.discount</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="order_id"/>
                <field name="client_id"/>
                <filter name="filter_draft" string="Brouillon" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_done" string="Confirmé" domain="[('state', '=', 'done')]"/>
                <filter name="filter_cancel" string="Annulé" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_casa_stock_discount" model="ir.actions.act_window">
        <field name="name">Réductions</field>
        <field name="res_model">casa.stock.discount</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle réduction commerciale.
            </p>
            <p>
                Les réductions permettent d'appliquer des remises sur les commandes confirmées tout en préservant les prix initiaux.
            </p>
        </field>
    </record>
</odoo>
