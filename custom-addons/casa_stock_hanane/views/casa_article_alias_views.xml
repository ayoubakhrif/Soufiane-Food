<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_article_form_inherit_alias" model="ir.ui.view">
        <field name="name">company.article.form.inherit.alias</field>
        <field name="model">company.article</field>
        <field name="inherit_id" ref="company_data.view_company_article_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Traductions" groups="casa_stock_hanane.group_user,casa_stock_hanane.group_viewer">
                        <field name="alias_ids">
                            <tree editable="bottom">
                                <field name="name" string="Alias (Darija / Arabe)"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
