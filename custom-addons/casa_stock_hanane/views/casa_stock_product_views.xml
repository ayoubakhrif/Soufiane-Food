<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_casa_product_standard_form" model="ir.ui.view">
        <field name="name">casa.product.standard.form</field>
        <field name="model">casa.product</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_product_report" string="Stock Produit" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du produit (Standard)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="article_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
