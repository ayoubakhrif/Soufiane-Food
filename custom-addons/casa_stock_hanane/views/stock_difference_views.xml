<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu Différence Root -->
    <menuitem id="menu_casa_hanane_difference_root"
              name="Différence"
              parent="menu_casa_stock_root"
              sequence="65"/>

    <!-- ============================================== -->
    <!--            DIFFERENCES PRODUITS                -->
    <!-- ============================================== -->
    <record id="view_casa_hanane_stock_difference_tree" model="ir.ui.view">
        <field name="name">casa_hanane.stock.difference.tree</field>
        <field name="model">casa_hanane.stock.difference</field>
        <field name="arch" type="xml">
            <tree string="Différence produits" create="false" edit="false" delete="false">
                <field name="article_id"/>
                <field name="quantity_casa"/>
                <field name="quantity_hanane"/>
                <field name="difference"/>
            </tree>
        </field>
    </record>

    <record id="action_casa_hanane_stock_difference" model="ir.actions.act_window">
        <field name="name">Différence produits</field>
        <field name="res_model">casa_hanane.stock.difference</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Il n'y a aucune différence de stock pour le moment.
            </p>
        </field>
    </record>

    <menuitem id="menu_casa_hanane_stock_difference"
              name="Différence produits"
              parent="menu_casa_hanane_difference_root"
              action="action_casa_hanane_stock_difference"
              sequence="10"/>

    <!-- ============================================== -->
    <!--            DIFFERENCES CLIENTS                 -->
    <!-- ============================================== -->
    <record id="view_casa_hanane_client_difference_tree" model="ir.ui.view">
        <field name="name">casa_hanane.client.difference.tree</field>
        <field name="model">casa_hanane.client.difference</field>
        <field name="arch" type="xml">
            <tree string="Différence clients" create="false" edit="false" delete="false">
                <field name="client_name"/>
                <field name="compte_total_casa"/>
                <field name="compte_total_hanane"/>
                <field name="difference"/>
            </tree>
        </field>
    </record>

    <record id="action_casa_hanane_client_difference" model="ir.actions.act_window">
        <field name="name">Différence clients</field>
        <field name="res_model">casa_hanane.client.difference</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Il n'y a aucune différence client pour le moment.
            </p>
        </field>
    </record>

    <menuitem id="menu_casa_hanane_client_difference"
              name="Différence clients"
              parent="menu_casa_hanane_difference_root"
              action="action_casa_hanane_client_difference"
              sequence="20"/>

    <!-- ============================================== -->
    <!--     INJECTION INTO CASA STOCK MAIN MODULE      -->
    <!-- ============================================== -->
    <menuitem id="menu_casa_stock_difference_root_in_casa"
              name="Différence"
              parent="casa_stock.menu_casa_stock_root"
              sequence="65"/>

    <menuitem id="menu_casa_stock_stock_difference_in_casa"
              name="Différence produits"
              parent="menu_casa_stock_difference_root_in_casa"
              action="action_casa_hanane_stock_difference"
              sequence="10"/>

    <menuitem id="menu_casa_stock_client_difference_in_casa"
              name="Différence clients"
              parent="menu_casa_stock_difference_root_in_casa"
              action="action_casa_hanane_client_difference"
              sequence="20"/>

</odoo>
