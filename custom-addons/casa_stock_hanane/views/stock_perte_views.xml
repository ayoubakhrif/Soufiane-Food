<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_casa_stock_perte_hanane_tree" model="ir.ui.view">
        <field name="name">casa_hanane.stock.perte.tree</field>
        <field name="model">casa_hanane.stock.perte</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="create_uid" string="Créé par" widget="many2one_avatar_user" optional="show"/>
                <field name="product_id"/>
                <field name="lot" optional="show"/>
                <field name="dum" optional="show"/>
                <field name="qty"/>
                <field name="tonnage" optional="show"/>
                <field name="ville" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_casa_stock_perte_hanane_form" model="ir.ui.view">
        <field name="name">casa_hanane.stock.perte.form</field>
        <field name="model">casa_hanane.stock.perte</field>
        <field name="arch" type="xml">
            <form string="Déclaration de Perte" create="false">
                <header>
                    <button name="action_validate" string="Valider la perte" type="object" class="btn-primary" invisible="state != 'draft'" confirm="Êtes-vous sûr de vouloir valider cette perte ? Elle sera définitivement déduite du stock."/>
                    <button name="action_cancel" string="Annuler" type="object" class="btn-danger" invisible="state != 'done'" confirm="Êtes-vous sûr de vouloir annuler cette perte ? Le stock sera restauré."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="stock_details" string="Sélection du Stock">
                            <field name="stock_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        
                        <group name="loss_details" string="Détails de la Perte">
                            <field name="date"/>
                            <field name="qty"/>
                            <field name="commentary" placeholder="Raison de la perte (ex: marchandise abîmée, erreur d'inventaire)"/>
                        </group>
                    </group>
                    <group string="Informations Complémentaires (Auto-complétées)" invisible="not stock_id">
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="lot" readonly="1"/>
                            <field name="dum" readonly="1"/>
                            <field name="weight" readonly="1"/>
                            <field name="calibre" readonly="1"/>
                        </group>
                        <group>
                            <field name="ville" readonly="1"/>

                            <field name="ste_id" readonly="1"/>
                            <field name="price_purchase" readonly="1"/>
                            <field name="stock_soufiane" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_casa_stock_perte_hanane_search" model="ir.ui.view">
        <field name="name">casa_hanane.stock.perte.search</field>
        <field name="model">casa_hanane.stock.perte</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="state"/>
                <filter string="Validés" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Brouillon" name="draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter string="Produit" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Mois" name="group_date" context="{'group_by':'date:month'}"/>
                    <filter string="État" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_casa_stock_perte_hanane" model="ir.actions.act_window">
        <field name="name">Pertes de Stock Hanane</field>
        <field name="res_model">casa_hanane.stock.perte</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_casa_stock_perte_hanane_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Déclarer une nouvelle perte
            </p>
            <p>
                Utilisez cette page pour les articles manquants qui doivent être déduits du stock.
            </p>
        </field>
    </record>

</odoo>
