<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_casa_stock_stock_kanban" model="ir.ui.view">
        <field name="name">casa_hanane.stock.stock.kanban</field>
        <field name="model">casa_hanane.stock.stock</field>
        <field name="arch" type="xml">
            <kanban create="false" delete="false" class="o_kanban_clickable">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="calibre"/>
                <field name="price"/>
                <field name="mt_achat"/>
                <field name="lot"/>
                <field name="ville"/>
                <field name="image_1920"/>
                <field name="weight"/>
                <field name="dum"/>
                <field name="frigo"/>
                <field name="ste_id"/>
                <field name="scan_dum"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record oe_kanban_global_click"
                            style="
                                border-radius:12px;
                                border:1px solid #e5e7eb;
                                box-shadow:0 4px 14px rgba(0,0,0,0.08);
                                background:#ffffff;
                                padding:12px;
                                display:flex;
                                gap:14px;
                            "
                            >

                            <!-- 🖼️ Image -->
                            <aside style="width:90px; height:90px; flex-shrink:0;">
                                <div class="o_kanban_image_fill w-100 h-100">
                                    <field name="image_1920"
                                        widget="image"
                                        class="w-100 h-100 rounded"
                                        options="{'img_class': 'object-fit-cover'}"/>
                                </div>
                            </aside>

                            <!-- 📋 Infos -->
                            <div class="flex-grow-1">

                                <!-- Produit -->
                                <div style="font-weight:700; font-size:15px; color:#111827; margin-bottom:6px;">
                                    <field name="product_id"/>
                                </div>

                                <!-- Badges -->
                                <div style="margin-bottom:8px;">
                                    <span style="
                                        background:#e0f2fe;
                                        color:#0369a1;
                                        padding:2px 8px;
                                        border-radius:999px;
                                        font-size:12px;
                                        margin-right:6px;">
                                        <field name="ville"/>
                                    </span>

                                    <span style="
                                        background:#f0fdf4;
                                        color:#166534;
                                        padding:2px 8px;
                                        border-radius:999px;
                                        font-size:12px;
                                        margin-right:6px;">
                                        <field name="ste_id"/>
                                    </span>

                                    <span style="
                                        background:#f3f4f6;
                                        color:#374151;
                                        padding:2px 8px;
                                        border-radius:999px;
                                        font-size:12px;">
                                        Calibre <field name="calibre"/>
                                    </span>

                                    <span t-if="record.stock_soufiane.raw_value" style="
                                        background:#fdf2f8;
                                        color:#9d174d;
                                        padding:2px 8px;
                                        border-radius:999px;
                                        font-size:12px;
                                        font-weight:bold;
                                        margin-right:6px;">
                                        SOUFIANE
                                    </span>
                                </div>

                                <!-- Stock -->
                                <div style="font-size:13px; color:#374151; line-height:1.6;">
                                    <div>
                                        📦 <b>Quantité :</b>
                                        <span style="color:#059669;">
                                            <field name="quantity"/>
                                        </span>
                                    </div>
                                    <div>
                                        ⚖️ <b>Poids :</b> <field name="poids"/> (Tonnage: <field name="total_weight"/> Kg)
                                    </div>
                                    <div>
                                        📍 <b>Frigo :</b> <field name="frigo"/>
                                    </div>
                                </div>

                                <hr style="margin:8px 0; border:none; border-top:1px dashed #e5e7eb;"/>

                                <!-- Financier -->
                                <div style="font-size:13px; color:#374151; line-height:1.6;">
                                    <div>
                                        💰 <b>Dernier Prix :</b>
                                        <span style="color:#1d4ed8;">
                                            <field name="price"/>
                                        </span>
                                    </div>
                                    <div>
                                        🧾 <b>Mt Achat Tot :</b>
                                        <span style="color:#7c2d12;">
                                            <field name="mt_achat"/>
                                        </span>
                                    </div>
                                    <div>
                                        🏷️ <b>Lot :</b> <field name="lot"/> | <b>DUM :</b> <field name="dum"/>
                                        <!-- DUM Indicator -->
                                        <t t-if="record.dum.raw_value">
                                            <t t-if="record.scan_dum.raw_value">
                                                <span title="DUM Disponible" style="display:inline-block; width:10px; height:10px; background-color:#22c55e; border-radius:50%; margin-left:4px;"></span>
                                            </t>
                                            <t t-else="">
                                                <span title="DUM Manquant (Drive)" style="display:inline-block; width:10px; height:10px; background-color:#ef4444; border-radius:50%; margin-left:4px;"></span>
                                            </t>
                                        </t>
                                        <a type="object" name="action_open_dum" class="btn btn-sm btn-secondary pt-0 pb-0" 
                                           style="font-size: 11px; margin-left:8px; height: 18px; line-height: 18px;" 
                                           target="_blank" t-if="record.dum.raw_value">
                                            Ouvrir DUM
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_casa_stock_stock_tree" model="ir.ui.view">
        <field name="name">casa_hanane.stock.stock.tree</field>
        <field name="model">casa_hanane.stock.stock</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="date"/>
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="ville"/>
                <field name="frigo"/>
                <field name="ste_id"/>
                <field name="quantity" sum="Total Quantité"/>
                <field name="poids"/>
                <field name="total_weight" sum="Total Poids"/>
                <field name="price"/>
                <field name="mt_achat" sum="Total Mt Achat"/>
            </tree>
        </field>
    </record>

    <record id="view_casa_stock_stock_form" model="ir.ui.view">
        <field name="name">casa_hanane.stock.stock.form</field>
        <field name="model">casa_hanane.stock.stock</field>
        <field name="arch" type="xml">
            <form string="Ligne de Stock" create="false" edit="false">
                <header>
                    <button name="action_new_exit" string="Nouvelle Sortie" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Détails Stock">
                            <field name="quantity"/>
                            <field name="weight"/>
                            <field name="total_weight"/>
                            <field name="calibre"/>
                            <field name="lot"/>
                            <field name="stock_soufiane"/>
                            <label for="dum"/>
                            <div class="o_row">
                                <field name="dum"/>
                                <button name="action_open_dum" string="Ouvrir DUM" type="object" icon="fa-external-link" class="btn-sm btn-link" invisible="not dum"/>
                            </div>
                            <field name="scan_dum" widget="url" invisible="not scan_dum"/>
                        </group>
                        <group string="Localisation &amp; Finance">
                            <field name="ville"/>
                            <field name="frigo"/>
                            <field name="ste_id"/>
                            <field name="price"/>
                            <field name="mt_achat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_casa_stock_stock_search" model="ir.ui.view">
        <field name="name">casa_hanane.stock.stock.search</field>
        <field name="model">casa_hanane.stock.stock</field>
        <field name="arch" type="xml">
            <search string="Recherche Stock">
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="ville"/>
                <field name="frigo"/>
                <field name="ste_id"/>
                <field name="date"/>
                <group expand="0" string="Grouper par">
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Produit" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Société" name="group_ste" context="{'group_by': 'ste_id'}"/>
                    <filter string="Ville" name="group_ville" context="{'group_by': 'ville'}"/>
                    <filter string="Frigo" name="group_frigo" context="{'group_by': 'frigo'}"/>
                    <filter string="Stock Soufiane" name="group_stock_soufiane" context="{'group_by': 'stock_soufiane'}"/>
                    <filter string="Poids" name="group_poids" context="{'group_by': 'poids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_casa_stock_stock_pivot" model="ir.ui.view">
        <field name="name">casa_hanane.stock.stock.pivot</field>
        <field name="model">casa_hanane.stock.stock</field>
        <field name="arch" type="xml">
            <pivot string="Analyse Stock">
                <field name="ville" type="row"/>
                <field name="product_id" type="row"/>
                <field name="poids" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="total_weight" type="measure"/>
                <field name="mt_achat" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_casa_stock_stock" model="ir.actions.act_window">
        <field name="name">Stock Casa</field>
        <field name="res_model">casa_hanane.stock.stock</field>
        <field name="view_mode">kanban,tree,form,pivot</field>
        <field name="domain">[('quantity', '!=', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun stock disponible.
            </p>
        </field>
    </record>

    <!-- Adding "New Exit" to the Action menu of the Stock view -->
    <record id="action_new_exit_binding" model="ir.actions.server">
        <field name="name">Nouvelle Sortie</field>
        <field name="model_id" ref="model_casa_hanane_stock_stock"/>
        <field name="binding_model_id" ref="model_casa_hanane_stock_stock"/>
        <field name="binding_view_types">kanban,list</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            action = records[0].action_new_exit()
        </field>
    </record>


</odoo>
