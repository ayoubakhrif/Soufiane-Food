<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_contacts_sf" model="ir.module.category">
        <field name="name">Contacts SF</field>
        <field name="description">Niveaux d'accès pour le module Contacts SF</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_contacts_sf_viewer" model="res.groups">
        <field name="name">Lecteur Contacts SF</field>
        <field name="category_id" ref="module_category_contacts_sf"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_contacts_sf_user" model="res.groups">
        <field name="name">Utilisateur Contacts SF</field>
        <field name="category_id" ref="module_category_contacts_sf"/>
        <field name="implied_ids" eval="[(4, ref('group_contacts_sf_viewer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_contacts_sf_admin" model="res.groups">
        <field name="name">Administrateur Contacts SF</field>
        <field name="category_id" ref="module_category_contacts_sf"/>
        <field name="implied_ids" eval="[(4, ref('group_contacts_sf_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
