<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Catégorie pour le module TVA -->
        <record model="ir.module.category" id="module_category_tva">
            <field name="name">Contrôle TVA</field>
            <field name="description">Accès au module de contrôle de la TVA</field>
            <field name="sequence">10</field>
        </record>

        <!-- Groupe Utilisateur : Peut créer, lire et modifier, mais pas supprimer -->
        <record id="group_tva_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_tva"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Groupe Administrateur : Possède tous les droits (hérite de l'utilisateur) -->
        <record id="group_tva_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_tva"/>
            <field name="implied_ids" eval="[(4, ref('group_tva_user'))]"/>
        </record>
    </data>
</odoo>
