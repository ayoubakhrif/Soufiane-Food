<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tva_fournisseur_tree" model="ir.ui.view">
        <field name="name">tva.fournisseur.tree</field>
        <field name="model">tva.fournisseur</field>
        <field name="arch" type="xml">
            <tree string="Fournisseurs">
                <field name="name"/>
                <field name="if_number"/>
                <field name="ice_number"/>
                <field name="convention"/>
            </tree>
        </field>
    </record>

    <record id="view_tva_fournisseur_form" model="ir.ui.view">
        <field name="name">tva.fournisseur.form</field>
        <field name="model">tva.fournisseur</field>
        <field name="arch" type="xml">
            <form string="Fournisseur">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="if_number"/>
                        <field name="ice_number"/>
                        <field name="convention"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tva_fournisseur" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">tva.fournisseur</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
