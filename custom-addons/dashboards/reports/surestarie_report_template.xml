<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_surestarie_compare" model="ir.actions.report">
        <field name="name">Rapport Comparatif Surestarie</field>
        <field name="model">surestarie.magasinage.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dashboards.report_surestarie_compare_template</field>
        <field name="report_file">dashboards.report_surestarie_compare_template</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_surestarie_compare_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; padding: 20px;">
                    
                    <!-- En-tête du Rapport -->
                    <div class="text-center mt-4 mb-5" style="border-bottom: 2px solid #2C3E50; padding-bottom: 15px;">
                        <h2 style="color: #2C3E50; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">Rapport de Surestarie &amp; Magasinage</h2>
                        <h4 style="color: #7F8C8D; margin-top: 5px;">Analyse Comparative : Logistique vs Finance</h4>
                    </div>
                    
                    <table class="table table-sm mt-4" style="border-collapse: collapse; width: 100%; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                        <thead>
                            <tr style="background-color: #34495E; color: #FFFFFF; font-size: 12px; text-transform: uppercase;">
                                <th class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;">Semaine</th>
                                <th class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;">Nb Conteneurs</th>
                                <th class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50; background-color: #2980B9;">Logistique<br/><span style="font-size:10px; font-weight:normal;">(Surestarie / Magasinage)</span></th>
                                <th class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50; background-color: #27AE60;">Finance<br/><span style="font-size:10px; font-weight:normal;">(Surestarie / Magasinage)</span></th>
                                <th class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50; background-color: #E74C3C;">Ecart (Log - Fin)<br/><span style="font-size:10px; font-weight:normal;">(Surestarie / Magasinage)</span></th>
                            <th class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50; background-color: #8E44AD;">Moyennes globales<br/><span style="font-size:10px; font-weight:normal;">(Sur/Ct | Mag/Ct)</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="report_data" t-as="row">
                            <tr t-att-style="row_parity == 'even' and 'border-bottom: 1px solid #BDC3C7; background-color: #F8F9FA;' or 'border-bottom: 1px solid #BDC3C7; background-color: #FFFFFF;'">
                                <td class="text-center align-middle" style="padding: 10px; border-left: 1px solid #BDC3C7; border-right: 1px solid #BDC3C7;">
                                    <strong><span t-esc="row['week']"/></strong>
                                </td>
                                <td class="text-center align-middle" style="padding: 10px; border-right: 1px solid #BDC3C7; font-weight: bold; color: #2C3E50;">
                                    <span t-esc="row['container_count']"/>
                                </td>
                                
                                <!-- Logistique -->
                                <td class="text-center align-middle" style="padding: 10px; border-right: 1px solid #BDC3C7; color: #2980B9; font-weight: bold;">
                                    <span t-esc="row['log_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> / 
                                    <span t-esc="row['log_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                
                                <!-- Finance -->
                                <td class="text-center align-middle" style="padding: 10px; border-right: 1px solid #BDC3C7; color: #27AE60; font-weight: bold;">
                                    <span t-esc="row['fin_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> / 
                                    <span t-esc="row['fin_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                
                                <!-- Ecarts -->
                                <td class="text-center align-middle" style="padding: 10px; border-right: 1px solid #BDC3C7; font-weight: bold;">
                                    <span t-esc="row['diff_surestarie']" t-options="{'widget': 'float', 'precision': 2}" t-att-style="row['diff_surestarie'] != 0 and 'color: #C0392B;' or 'color: #2C3E50;'"/> / 
                                    <span t-esc="row['diff_magasinage']" t-options="{'widget': 'float', 'precision': 2}" t-att-style="row['diff_magasinage'] != 0 and 'color: #C0392B;' or 'color: #2C3E50;'"/>
                                </td>
                                
                                <!-- Moyennes -->
                                <td class="text-center align-middle" style="padding: 10px; border-right: 1px solid #BDC3C7; color: #8E44AD; font-weight: bold;">
                                    <span t-esc="row['avg_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> | 
                                    <span t-esc="row['avg_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                            </tr>
                        </t>
                        
                        <!-- Ligne de totalisation -->
                        <t t-if="totals">
                            <tr style="background-color: #2C3E50; color: #FFFFFF; font-weight: bold; font-size: 14px;">
                                <td class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;">TOTAL</td>
                                <td class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;"><span t-esc="totals['container_count']"/></td>
                                <td class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;">
                                    <span t-esc="totals['log_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> / 
                                    <span t-esc="totals['log_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;">
                                    <span t-esc="totals['fin_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> / 
                                    <span t-esc="totals['fin_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;">
                                    <span t-esc="totals['diff_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> / 
                                    <span t-esc="totals['diff_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                                </td>
                                <td class="text-center align-middle" style="padding: 12px; border: 1px solid #2C3E50;">-</td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                
                <t t-if="totals">
                    <div style="margin-top: 30px; padding: 15px; border: 1px solid #BDC3C7; background-color: #F8F9FA; border-radius: 5px;">
                        <h4 style="color: #2C3E50; margin-top: 0;">Moyennes Globales Consolidees</h4>
                        <table style="width: 100%; font-size: 14px;">
                            <tr>
                                <td style="padding: 8px 0; color: #2980B9;"><strong>Moyenne Globale Logistique :</strong></td>
                                <td style="text-align: right; padding: 8px 0;"><strong><span t-esc="totals['log_global_avg']" t-options="{'widget': 'float', 'precision': 2}"/> / Conteneur</strong></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 0; color: #27AE60; border-top: 1px dashed #BDC3C7;"><strong>Moyenne Globale Finance :</strong></td>
                                <td style="text-align: right; padding: 8px 0; border-top: 1px dashed #BDC3C7;"><strong><span t-esc="totals['fin_global_avg']" t-options="{'widget': 'float', 'precision': 2}"/> / Conteneur</strong></td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 0; color: #E74C3C; border-top: 1px solid #BDC3C7;"><strong>Différence (Logistique - Finance) :</strong></td>
                                <td style="text-align: right; padding: 8px 0; border-top: 1px solid #BDC3C7;">
                                    <strong t-att-style="totals['diff_global_avg'] != 0 and 'color: #C0392B;' or 'color: #2C3E50;'">
                                        <span t-esc="totals['diff_global_avg']" t-options="{'widget': 'float', 'precision': 2}"/> / Conteneur
                                    </strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
                
                <!-- Note de bas de page -->
                <div class="mt-5 text-right" style="font-size: 11px; color: #7F8C8D; border-top: 1px solid #ECF0F1; padding-top: 10px;">
                    <em>This document is generated by Gestia</em>
                </div>
            </div>
            </t>
        </t>
    </template>

    <record id="action_report_surestarie_week_details" model="ir.actions.report">
        <field name="name">Détail Surestarie Semaine</field>
        <field name="model">surestarie.magasinage.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dashboards.report_surestarie_week_details_template</field>
        <field name="report_file">dashboards.report_surestarie_week_details_template</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_surestarie_week_details_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 12px; padding: 20px;">
                    
                    <!-- En-tête -->
                    <div class="text-center mt-4 mb-4" style="border-bottom: 2px solid #2C3E50; padding-bottom: 10px;">
                        <h2 style="color: #2C3E50; font-weight: bold; text-transform: uppercase;">Détail de la Semaine <span t-esc="week_name"/></h2>
                        <h5 style="color: #7F8C8D;">Surestarie &amp; Magasinage (Logistique vs Finance)</h5>
                    </div>

                    <!-- Synthèse de la semaine -->
                    <div style="background-color: #F8F9FA; padding: 15px; border-radius: 5px; border-left: 4px solid #34495E; margin-bottom: 30px;">
                        <h4 style="color: #2C3E50; margin-top: 0; font-weight: bold;">Synthèse</h4>
                        <div class="row">
                            <div class="col-4">
                                <strong>Nb Conteneurs : </strong> <span t-esc="totals['container_count']"/><br/>
                            </div>
                            <div class="col-4">
                                <strong style="color: #2980B9;">Logistique Brut : </strong> 
                                S: <span t-esc="totals['log_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> | 
                                M: <span t-esc="totals['log_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </div>
                            <div class="col-4">
                                <strong style="color: #27AE60;">Finance Payé : </strong> 
                                S: <span t-esc="totals['fin_surestarie']" t-options="{'widget': 'float', 'precision': 2}"/> | 
                                M: <span t-esc="totals['fin_magasinage']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </div>
                        </div>
                    </div>

                    <!-- 1. LOGISTIQUE -->
                    <h4 style="color: #2980B9; border-bottom: 1px solid #2980B9; padding-bottom: 5px; margin-top: 20px;">Détails Logistique (Déclaré)</h4>
                    <table class="table table-sm" style="width: 100%; border-collapse: collapse; font-size: 11px;">
                        <thead>
                            <tr style="background-color: #ECF0F1; color: #2C3E50;">
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Date BAD</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">BL</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Article</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Fournisseur</th>
                                <th class="text-center" style="border: 1px solid #BDC3C7; padding: 5px;">Nb CT</th>
                                <th class="text-right" style="border: 1px solid #BDC3C7; padding: 5px;">Surestarie</th>
                                <th class="text-right" style="border: 1px solid #BDC3C7; padding: 5px;">Magasinage</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="log_details" t-as="log">
                                <tr>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="log['bad_date']" t-options="{'widget': 'date'}"/></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><strong><span t-esc="log['bl_number']"/></strong></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="log['article_id'][1] if log['article_id'] else ''"/></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="log['supplier_id'][1] if log['supplier_id'] else ''"/></td>
                                    <td class="text-center" style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="log['container_count']"/></td>
                                    <td class="text-right" style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="log['surestarie_amount']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                    <td class="text-right" style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="log['magasinage_amount']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                </tr>
                            </t>
                            <t t-if="not log_details">
                                <tr><td colspan="7" class="text-center" style="border: 1px solid #BDC3C7; padding: 10px;"><em>Aucun enregistrement logistique pour cette semaine.</em></td></tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- 2. FINANCE CHEQUES -->
                    <h4 style="color: #27AE60; border-bottom: 1px solid #27AE60; padding-bottom: 5px; margin-top: 30px;">Détails Finance - Chèques Payés</h4>
                    <table class="table table-sm" style="width: 100%; border-collapse: collapse; font-size: 11px;">
                        <thead>
                            <tr style="background-color: #ECF0F1; color: #2C3E50;">
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">N° Chèque</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Bénéficiaire</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Date Émission</th>
                                <th class="text-center" style="border: 1px solid #BDC3C7; padding: 5px;">Type</th>
                                <th class="text-right" style="border: 1px solid #BDC3C7; padding: 5px;">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="fin_cheques_details" t-as="chq">
                                <tr>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><strong><span t-esc="chq['chq']"/></strong></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="chq['benif_id'][1] if chq.get('benif_id') else ''"/></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="chq['date_emission']" t-options="{'widget': 'date'}"/></td>
                                    <td class="text-center" style="border: 1px solid #BDC3C7; padding: 5px; text-transform: capitalize;"><span t-esc="chq['type']"/></td>
                                    <td class="text-right" style="border: 1px solid #BDC3C7; padding: 5px; color: #27AE60; font-weight: bold;"><span t-esc="chq['amount']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                </tr>
                            </t>
                            <t t-if="not fin_cheques_details">
                                <tr><td colspan="5" class="text-center" style="border: 1px solid #BDC3C7; padding: 10px;"><em>Aucun chèque pour cette semaine.</em></td></tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- 3. FINANCE DEDUCTIONS -->
                    <h4 style="color: #8E44AD; border-bottom: 1px solid #8E44AD; padding-bottom: 5px; margin-top: 30px;">Détails Finance - Déductions Payées</h4>
                    <table class="table table-sm" style="width: 100%; border-collapse: collapse; font-size: 11px;">
                        <thead>
                            <tr style="background-color: #ECF0F1; color: #2C3E50;">
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Date Opération</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Bénéficiaire</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">Réf Facture/Opé</th>
                                <th style="border: 1px solid #BDC3C7; padding: 5px;">BL (Dossier)</th>
                                <th class="text-center" style="border: 1px solid #BDC3C7; padding: 5px;">Type</th>
                                <th class="text-right" style="border: 1px solid #BDC3C7; padding: 5px;">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="fin_deductions_details" t-as="ded">
                                <tr>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="ded['date']" t-options="{'widget': 'date'}"/></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="ded['benif_id'][1] if ded.get('benif_id') else ''"/></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><span t-esc="ded['operation_ref']"/></td>
                                    <td style="border: 1px solid #BDC3C7; padding: 5px;"><strong><span t-esc="ded['bl_id'][1] if ded.get('bl_id') else ''"/></strong></td>
                                    <td class="text-center" style="border: 1px solid #BDC3C7; padding: 5px; text-transform: capitalize;"><span t-esc="ded['type']"/></td>
                                    <td class="text-right" style="border: 1px solid #BDC3C7; padding: 5px; color: #8E44AD; font-weight: bold;"><span t-esc="ded['amount']" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                </tr>
                            </t>
                            <t t-if="not fin_deductions_details">
                                <tr><td colspan="6" class="text-center" style="border: 1px solid #BDC3C7; padding: 10px;"><em>Aucune déduction pour cette semaine.</em></td></tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="mt-5 text-right" style="font-size: 11px; color: #7F8C8D; border-top: 1px solid #ECF0F1; padding-top: 10px;">
                        <em>This document is generated by Gestia</em>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
