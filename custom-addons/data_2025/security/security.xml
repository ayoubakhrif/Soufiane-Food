<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_data_2025_category" model="ir.module.category">
        <field name="name">Data 2025</field>
        <field name="description">Gestion des accès pour le module Data 2025</field>
        <field name="sequence">16</field>
    </record>

    <record id="group_data_2025_user" model="res.groups">
        <field name="name">Utilisateur Data 2025</field>
        <field name="category_id" ref="module_data_2025_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_data_2025_manager" model="res.groups">
        <field name="name">Responsable Data 2025</field>
        <field name="category_id" ref="module_data_2025_category"/>
        <field name="implied_ids" eval="[(4, ref('group_data_2025_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
