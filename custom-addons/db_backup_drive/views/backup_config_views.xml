<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_db_backup_drive_config_form" model="ir.ui.view">
        <field name="name">db.backup.drive.config.form</field>
        <field name="model">db.backup.drive.config</field>
        <field name="arch" type="xml">
            <form string="Google Drive Backup Configuration" duplicate="0" delete="0">
                <header>
                    <button name="action_backup_now" string="Backup Now" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="1. Identifiants Google Cloud" invisible="refresh_token">
                        <field name="client_id" placeholder="Ex: 123456-abcdef.apps.googleusercontent.com"/>
                        <field name="client_secret" password="True" placeholder="Votre client secret"/>
                        <button name="action_generate_auth_url" string="Générer l'URL d'autorisation" 
                                type="object" class="btn-primary" invisible="not client_id or not client_secret"/>
                    </group>
                    
                    <!-- Option directe : coller le refresh token généré avec le script local -->
                    <group string="OU : Coller le Refresh Token directement" invisible="refresh_token">
                        <field name="client_id" placeholder="Client ID" invisible="client_id"/>
                        <field name="client_secret" password="True" placeholder="Client Secret" invisible="client_secret"/>
                        <field name="refresh_token" placeholder="Collez le Refresh Token ici (généré via le script local)"/>
                        <field name="folder_id"/>
                        <field name="master_password" password="True" placeholder="Mot de passe maître Odoo"/>
                    </group>

                    <group string="2. Autorisation" invisible="not auth_url or refresh_token">
                        <field name="auth_url" widget="url" text="Cliquez ici pour autoriser Odoo" readonly="1"/>
                        <field name="auth_code" placeholder="Collez le code ici après avoir autorisé"/>
                        <button name="action_validate_auth_code" string="Valider le code" 
                                type="object" class="btn-success" invisible="not auth_code"/>
                    </group>

                    <group string="Configuration Active" invisible="not refresh_token">
                        <group>
                            <field name="folder_id"/>
                            <field name="master_password" password="True"/>
                            <field name="refresh_token" password="True"/>
                            <field name="retention_count"/>
                        </group>
                        <group string="Dernier Backup">
                            <field name="last_backup_date"/>
                            <field name="last_backup_status" widget="badge" 
                                   decoration-success="last_backup_status == 'success'"
                                   decoration-danger="last_backup_status == 'failed'"/>
                        </group>
                    </group>
                    
                    <button name="action_generate_auth_url" string="Ré-initialiser l'autorisation" 
                            type="object" class="btn-secondary" invisible="not refresh_token"
                            confirm="Voulez-vous vraiment réinitialiser l'accès ?"/>

                    <group string="Erreur" invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong> Make sure you have shared the Google Drive folder with the service account email: 
                        <code>odoo-drive-service@nice-karma-477310-c3.iam.gserviceaccount.com</code>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_db_backup_drive_config" model="ir.actions.act_window">
        <field name="name">Backup to Google Drive</field>
        <field name="res_model">db.backup.drive.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" eval="False"/>
        <field name="target">current</field>
    </record>

    <!-- Use a function to get or create the singleton record for the action -->
    <record id="action_db_backup_drive_config_singleton" model="ir.actions.server">
        <field name="name">Google Drive Backup Configuration</field>
        <field name="model_id" ref="model_db_backup_drive_config"/>
        <field name="state">code</field>
        <field name="code">
            action = model.get_config().get_formview_action()
        </field>
    </record>

    <menuitem id="menu_db_backup_drive_root"
              name="Google Drive Backup"
              parent="base.menu_administration"
              sequence="100"/>

    <menuitem id="menu_db_backup_drive_config"
              name="Configuration"
              parent="menu_db_backup_drive_root"
              action="action_db_backup_drive_config_singleton"
              sequence="10"/>
</odoo>
