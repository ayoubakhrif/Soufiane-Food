<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_logistique_cheques_rappel" model="ir.cron">
            <field name="name">Rappel des chèques en réserve pris par la logistique</field>
            <field name="model_id" ref="model_finance_cheque_physical"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_logistique_cheques()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
