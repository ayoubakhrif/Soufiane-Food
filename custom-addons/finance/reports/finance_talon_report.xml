<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_finance_talon_summary" model="ir.actions.report">
        <field name="name">Rapport du Talon</field>
        <field name="model">finance.talon</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">finance.report_finance_talon_summary_template</field>
        <field name="report_file">finance.report_finance_talon_summary_template</field>
        <field name="binding_model_id" ref="model_finance_talon"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_finance_talon_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .report-header { margin-bottom: 20px; }
                            .header-row { display: flex; align-items: stretch; margin-bottom: 10px; }
                            .date-box { background-color: #FCE9DA; border: 1px solid black; padding: 10px; font-size: 20px; font-weight: bold; width: 25%; text-align: center; }
                            .talon-box { background-color: #6DA9DC; border: 1px solid black; padding: 10px; font-size: 20px; font-weight: bold; color: white; flex-grow: 1; text-align: center; }
                            
                            .section-header { background-color: #FCE9DA; border: 1px solid black; padding: 10px; font-size: 20px; font-weight: bold; text-align: center; text-transform: uppercase; margin-top: 20px; }
                            
                            .data-table { width: 100%; border-collapse: collapse; margin-top: 5px; }
                            .data-table th { background-color: #FCE9DA; border: 1px solid black; padding: 8px; text-align: center; font-size: 13px; font-weight: bold; }
                            .data-table td { border: 1px solid black; padding: 8px; text-align: center; font-size: 13px; }
                            
                            .summary-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                            .summary-table td { border: 1px solid black; padding: 12px; text-align: center; font-size: 16px; font-weight: bold; }
                            .label-peach { background-color: #FCE9DA; }
                            .val-blue { background-color: #6DA9DC; color: white; }
                            .val-orange { background-color: #FF9900; color: white; }
                            .val-cyan { background-color: #00FFFF; color: black; }
                            .val-green { background-color: #28a745; color: white; }

                            .footer { margin-top: 30px; font-style: italic; font-size: 10px; }
                        </style>

                        <!-- Header -->
                        <div class="report-header">
                            <div class="header-row">
                                <div class="date-box">
                                    <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%y')"/>
                                </div>
                                <div class="talon-box">
                                    TALON : <t t-esc="o.name_shown"/>
                                </div>
                            </div>
                            <div style="text-align: center; font-size: 18px; font-weight: bold; margin-top: 5px;">
                                Société: <t t-esc="o.ste_id.name"/>
                            </div>
                        </div>

                        <!-- Summary Table -->
                        <t t-set="stats" t-value="o.get_talon_stats()"/>
                        <table class="summary-table">
                            <tr>
                                <td class="label-peach" style="width: 25%;">NB TOTAL</td>
                                <td class="label-peach" style="width: 25%;">UTILISÉS</td>
                                <td class="label-peach" style="width: 25%;">RESTANTS</td>
                                <td class="label-peach" style="width: 25%;">ÉTAT</td>
                            </tr>
                            <tr>
                                <td class="val-blue"><t t-esc="stats['total']"/></td>
                                <td class="val-orange"><t t-esc="stats['used']"/></td>
                                <td class="val-cyan"><t t-esc="stats['remaining']"/></td>
                                <td class="val-green"><t t-esc="stats['etat']"/></td>
                            </tr>
                        </table>

                        <!-- Outgoing Checks Section -->
                        <div class="section-header">
                            DÉTAIL DES SORTIES (CHÈQUES ET EFFETS)
                        </div>
                        
                        <t t-set="outgoing_data" t-value="o.get_outgoing_checks_data()"/>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Référence</th>
                                    <th>Type</th>
                                    <th>Bénéficiaire</th>
                                    <th>Date Émission</th>
                                    <th>Montant</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="outgoing_data" t-as="line">
                                    <tr>
                                        <td style="font-weight: bold;"><t t-esc="line['ref']"/></td>
                                        <td><t t-esc="line['type']"/></td>
                                        <td style="text-align: left;"><t t-esc="line['benif']"/></td>
                                        <td>
                                            <t t-if="line['date']">
                                                <t t-esc="line['date'].strftime('%d/%m/%Y')"/>
                                            </t>
                                        </td>
                                        <td style="background-color: #FF9900; font-weight: bold; color: white;">
                                            <t t-esc="'{:,.2f}'.format(line['amount']).replace(',', ' ')"/> DH
                                        </td>
                                        <td>
                                            <t t-if="line['status'] == 'Encaissé'">
                                                <span style="color: green; font-weight: bold;">Encaissé</span>
                                                <t t-if="line['date_encaissement']">
                                                    <br/><span style="font-size: 10px;"><t t-esc="line['date_encaissement'].strftime('%d/%m/%y')"/></span>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <span style="color: orange;">En cours</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not outgoing_data">
                                    <tr>
                                        <td colspan="6" style="padding: 20px; font-style: italic;">
                                            Aucun chèque ou effet n'est encore sorti de ce talon.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="footer">
                            Généré par Gestia ERP - <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%H:%M:%S')"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
