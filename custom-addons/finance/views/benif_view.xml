<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ⚙️ Actions pour boutons -->
    <record id="finance_benif_action" model="ir.actions.act_window">
        <field name="name">Bénificiaires</field>
        <field name="res_model">finance.benif</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_finance_benif_form" model="ir.ui.view">
        <field name="name">finance.benif.form</field>
        <field name="model">finance.benif</field>
        <field name="arch" type="xml">
            <form string="Bénificiaires">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="days"/>
                        <field name="type"/>
                        <field name="benif_deduction"/>
                    </group>
                    <notebook>
                        <page string="Chèques">
                            <field name="physical_chq_ids" readonly="1">
                                <tree>
                                    <field name="name" string="Chèque"/>
                                    <field name="ste_id"/>
                                    <field name="date_emission"/>
                                    <field name="date_echeance"/>
                                    <field name="date_encaissement"/>
                                    <field name="credit" sum="Total Crédit"/>
                                    <field name="debit" sum="Total Débit"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_credit"/>
                                <field name="total_debit"/>
                                <field name="solde" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 🌳 Vue liste des clients -->
    <record id="view_finance_benif_tree" model="ir.ui.view">
        <field name="name">finance.benif.tree</field>
        <field name="model">finance.benif</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name"/>
                <field name="type"/>
                <field name="days"/>
                <field name="benif_deduction"/>
            </tree>
        </field>
    </record>

    <menuitem id="finance_benif_menu"
              name="Bénificiaires"
              parent="finance_root_menu"
              action="finance_benif_action"
              sequence="20"/>
</odoo>
