<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_finance_encaissement_physique_tree" model="ir.ui.view">
            <field name="name">finance.encaissement.physique.tree</field>
            <field name="model">finance.encaissement.physique</field>
            <field name="arch" type="xml">
                <tree string="Encaissements Physiques" decoration-info="create_date">
                    <field name="create_date" string="Date de saisie"/>
                    <field name="ste_id"/>
                    <field name="benif_id"/>
                    <field name="physical_cheque_id"/>
                    <field name="amount" sum="Total"/>
                    <field name="date_encaissement"/>
                    <field name="create_uid" string="Saisi par"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_finance_encaissement_physique_form" model="ir.ui.view">
            <field name="name">finance.encaissement.physique.form</field>
            <field name="model">finance.encaissement.physique</field>
            <field name="arch" type="xml">
                <form string="Encaissement Physique">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <span invisible="physical_cheque_id">Nouvel Encaissement Physique</span>
                                <field name="physical_cheque_id" readonly="1" invisible="not physical_cheque_id"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Sélection du Chèque">
                                <field name="ste_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="benif_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="physical_cheque_id" options="{'no_create': True, 'no_open': True}" 
                                       invisible="not ste_id or not benif_id"
                                       domain="[('ste_id', '=', ste_id), ('benif_id', '=', benif_id), ('encours', '!=', 'encaisse')]"/>
                            </group>
                            <group string="Validation" invisible="not physical_cheque_id">
                                <field name="amount" widget="monetary"/>
                                <field name="date_encaissement"/>
                            </group>
                        </group>
                        <notebook invisible="not encaissement_line_ids">
                            <page string="Répartitions Encaissées">
                                <field name="encaissement_line_ids">
                                    <tree string="Lignes" create="false" delete="false" edit="false">
                                        <field name="cheque_id"/>
                                        <field name="type"/>
                                        <field name="amount"/>
                                        <field name="date_encaissement"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter" groups="finance.group_finance_user">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_finance_encaissement_physique_search" model="ir.ui.view">
            <field name="name">finance.encaissement.physique.search</field>
            <field name="model">finance.encaissement.physique</field>
            <field name="arch" type="xml">
                <search string="Recherche Encaissements Physiques">
                    <field name="ste_id"/>
                    <field name="benif_id"/>
                    <field name="physical_cheque_id"/>
                    <group expand="1" string="Group By">
                        <filter string="Date d'encaissement" name="groupby_date" context="{'group_by':'date_encaissement:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_finance_encaissement_physique" model="ir.actions.act_window">
            <field name="name">Encaissement Physique</field>
            <field name="res_model">finance.encaissement.physique</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_groupby_date': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créer un encaissement physique
                </p>
                <p>
                    Encaisser un chèque physique va automatiquement marquer toutes ses répartitions comme encaissées.
                </p>
            </field>
        </record>
    </data>
</odoo>
