<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_contact_tree" model="ir.ui.view">
        <field name="name">finance.contact.tree</field>
        <field name="model">finance.contact</field>
        <field name="arch" type="xml">
            <tree string="Contacts Finance">
                <field name="name"/>
                <field name="telephone"/>
                <field name="gmail"/>
                <field name="ste"/>
                <field name="contact_sf_id" string="Contact Source"/>
            </tree>
        </field>
    </record>

    <record id="view_finance_contact_form" model="ir.ui.view">
        <field name="name">finance.contact.form</field>
        <field name="model">finance.contact</field>
        <field name="arch" type="xml">
            <form string="Contact Finance">
                <sheet>
                    <group>
                        <group>
                            <field name="contact_sf_id" options="{'no_create': True}"/>
                            <field name="telephone"/>
                        </group>
                        <group>
                            <field name="gmail"/>
                            <field name="ste"/>
                        </group>
                    </group>
                    <group>
                        <field name="commentaire"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_finance_contact" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">finance.contact</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier contact finance.
            </p>
        </field>
    </record>

    <menuitem id="finance_contact_menu"
              name="Contacts"
              parent="data_finance_menu"
              action="action_finance_contact"
              sequence="40"/>
</odoo>
