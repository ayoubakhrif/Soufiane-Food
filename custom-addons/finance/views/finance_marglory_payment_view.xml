<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_marglory_payment_tree" model="ir.ui.view">
        <field name="name">finance.marglory.payment.tree</field>
        <field name="model">finance.marglory.payment</field>
        <field name="arch" type="xml">
            <tree string="Paiements Marglory" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'">
                <field name="date"/>
                <field name="physical_cheque_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </tree>
        </field>
    </record>

    <record id="view_finance_marglory_payment_form" model="ir.ui.view">
        <field name="name">finance.marglory.payment.form</field>
        <field name="model">finance.marglory.payment</field>
        <field name="arch" type="xml">
            <form string="Paiement Marglory">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Remettre en brouillon" type="object" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="physical_cheque_id" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="cheque_id" invisible="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="cheque_amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Factures Marglory">
                            <field name="marglory_ids" readonly="state != 'draft'" domain="[('payment_id', '=', False)]">
                                <tree>
                                    <field name="bl_number"/>
                                    <field name="facture_marglory"/>
                                    <field name="dum"/>
                                    <field name="amount" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                 <div class="oe_chatter" groups="finance.group_finance_user">
                     <field name="message_follower_ids"/>
                     <field name="activity_ids"/>
                     <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_finance_marglory_payment_search" model="ir.ui.view">
        <field name="name">finance.marglory.payment.search</field>
        <field name="model">finance.marglory.payment</field>
        <field name="arch" type="xml">
            <search string="Recherche Paiements Marglory">
                <field name="physical_cheque_id"/>
                <field name="date"/>
                <field name="marglory_ids" string="Réglement N°" filter_domain="[('marglory_ids.dossier_reglement', 'ilike', self)]"/>
                <separator/>
                <filter string="Brouillon" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmé" name="confirmed" domain="[('state','=','confirmed')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Chèque" name="group_by_cheque" context="{'group_by':'physical_cheque_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by':'date'}"/>
                    <filter string="État" name="group_by_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_finance_marglory_payment" model="ir.actions.act_window">
        <field name="name">Paiements Marglory</field>
        <field name="res_model">finance.marglory.payment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_finance_marglory_payment"
              name="Paiements"
              parent="menu_finance_marglory"
              action="action_finance_marglory_payment"
              sequence="20"/>
</odoo>
