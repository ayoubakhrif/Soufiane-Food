<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_category_fridge">
            <field name="name">Gestion des Frigos</field>
            <field name="description">Niveaux d'accès pour la gestion des frigos.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_fridge_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_fridge"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Peut créer et modifier des dépôts et des mouvements.</field>
        </record>

        <record id="group_fridge_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_fridge"/>
            <field name="implied_ids" eval="[(4, ref('group_fridge_user'))]"/>
            <field name="comment">Peut gérer les équipements et supprimer des données.</field>
        </record>
    </data>
</odoo>
