<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bon_generation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .table-custom {
                                width: 100%;
                                border-collapse: collapse;
                            }
                            .table-custom th, .table-custom td {
                                border: 1px solid black;
                                padding: 5px;
                                text-align: center;
                            }
                            .table-lines {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 20px;
                            }
                            .table-lines th {
                                background-color: #d9d9d9;
                                border: none;
                                padding: 5px;
                                text-align: left;
                                font-weight: bold;
                            }
                            .table-lines td {
                                border: none;
                                padding: 5px;
                            }
                            .net-a-payer-header {
                                background-color: #d9d9d9;
                                padding: 5px 10px;
                                font-weight: bold;
                                text-align: right;
                            }
                            .net-a-payer-value {
                                background-color: #d9d9d9;
                                padding: 5px 10px;
                                font-weight: bold;
                                text-align: right;
                                margin-top: 5px;
                            }
                            .footer-address {
                                border-top: 1px solid black;
                                text-align: center;
                                font-size: 11px;
                                padding-top: 5px;
                            }
                        </style>

                        <div class="row">
                            <div class="col-5">
                                <img t-if="doc.company_id.image_1920" t-att-src="image_data_uri(doc.company_id.image_1920)" style="max-height: 120px;" alt="Logo"/>
                            </div>
                            <div class="col-7 text-right">
                                <h3 style="font-weight: bold; margin-bottom: 20px; text-align: center;">FACTURE PROFORMA</h3>
                                <div style="border: 1px solid black; padding: 10px; text-align: left; height: 100px;">
                                    <strong>TIME FRUIT</strong>
                                </div>
                                <div style="border: 1px solid black; border-top: none; padding: 5px; text-align: left;">
                                    <strong>ICE:</strong> 0025484880
                                </div>
                            </div>
                        </div>

                        <div class="row mt-5">
                            <div class="col-8">
                                <table class="table-custom">
                                    <thead>
                                        <tr>
                                            <th style="width: 50%;">Date</th>
                                            <th style="width: 50%;">Numéro</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><span t-field="doc.date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></td>
                                            <td><span t-field="doc.name"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <table class="table-lines mt-4">
                            <thead>
                                <tr>
                                    <th style="width: 50%;">Désignation</th>
                                    <th>Qte</th>
                                    <th>Px U, T</th>
                                    <th>Montant TTC</th>
                                    <th>*</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        <td><span t-esc="int(line.qte)"/></td>
                                        <td><span t-field="line.pu"/></td>
                                        <td><span t-field="line.montant_ttc" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        
                        <div class="row" style="margin-top: 50px;">
                            <div class="col-8"></div>
                            <div class="col-4">
                                <div class="net-a-payer-header">NET A PAYER</div>
                                <div class="net-a-payer-value">
                                    <span t-field="doc.total_ttc" t-options='{"widget": "float", "precision": 2}'/>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-top: 30px;">
                            <div class="col-6"></div>
                            <div class="col-6 text-center">
                                <img t-if="doc.company_id.cachet" t-att-src="image_data_uri(doc.company_id.cachet)" style="max-height: 140px; transform: rotate(-3deg);" alt="Cachet"/>
                            </div>
                        </div>
                    </div>
                    
                    <div class="footer o_standard_footer">
                        <div class="footer-address">
                            <span t-field="doc.company_id.name"/> <span t-if="doc.company_id.address" t-field="doc.company_id.address"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
