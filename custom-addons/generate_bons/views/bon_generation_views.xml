<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bon_generation_tree" model="ir.ui.view">
        <field name="name">bon.generation.tree</field>
        <field name="model">bon.generation</field>
        <field name="arch" type="xml">
            <tree string="Bons Proforma">
                <field name="name"/>
                <field name="date"/>
                <field name="company_id" context="{'display_code_only': True}"/>
                <field name="total_ttc"/>
            </tree>
        </field>
    </record>

    <record id="view_bon_generation_form" model="ir.ui.view">
        <field name="name">bon.generation.form</field>
        <field name="model">bon.generation</field>
        <field name="arch" type="xml">
            <form string="Bon Proforma">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" context="{'display_code_only': True}" options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lignes" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="article_id"/>
                                    <field name="name" force_save="1"/>
                                    <field name="qte"/>
                                    <field name="pu"/>
                                    <field name="montant_ttc" sum="Total Montant TTC"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="total">
                                <field name="total_ttc"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bon_generation" model="ir.actions.act_window">
        <field name="name">Bons Proforma</field>
        <field name="res_model">bon.generation</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
