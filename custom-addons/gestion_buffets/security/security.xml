<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_gestion_buffets_category" model="ir.module.category">
        <field name="name">Gestion Buffets</field>
        <field name="sequence">23</field>
    </record>

    <record id="group_gestion_buffets_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_gestion_buffets_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_gestion_buffets_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_gestion_buffets_category"/>
        <field name="implied_ids" eval="[(4, ref('group_gestion_buffets_user'))]"/>
    </record>
</odoo>
