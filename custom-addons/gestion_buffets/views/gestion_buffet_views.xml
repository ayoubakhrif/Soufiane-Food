<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: gestion.buffet Tree -->
    <record id="view_gestion_buffet_tree" model="ir.ui.view">
        <field name="name">gestion.buffet.tree</field>
        <field name="model">gestion.buffet</field>
        <field name="arch" type="xml">
            <tree string="Buffets">
                <field name="name"/>
                <field name="date"/>
                <field name="client_name"/>
                <field name="place_id"/>
                <field name="pack_id"/>
                <field name="nbr_personne"/>
                <field name="total_revenu" sum="Total"/>
                <field name="benefice" sum="Bénéfice"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'confirmed'"/>
            </tree>
        </field>
    </record>

    <!-- View: gestion.buffet Form -->
    <record id="view_gestion_buffet_form" model="ir.ui.view">
        <field name="name">gestion.buffet.form</field>
        <field name="model">gestion.buffet</field>
        <field name="arch" type="xml">
            <form string="Buffet">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Marquer comme Terminé" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_draft" string="Remettre en Brouillon" type="object" invisible="state not in ['cancel', 'confirmed']"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ['cancel', 'done']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Générales">
                            <field name="client_name"/>
                            <field name="date"/>
                            <field name="place_id"/>
                        </group>
                        <group string="Détails du Buffet">
                            <field name="pack_id"/>
                            <field name="nbr_personne"/>
                            <field name="prix_personne"/>
                            <field name="avance"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Composants">
                            <field name="composant_ids">
                                <tree editable="bottom">
                                    <field name="composant_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_total" sum="Total Composants"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Charges">
                            <field name="charge_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="amount" sum="Total Charges"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    
                    <group class="oe_subtotal_footer oe_right" colspan="2" name="buffet_total">
                        <field name="total_revenu"/>
                        <field name="avance"/>
                        <field name="reste_a_payer" class="oe_subtotal_footer_separator"/>
                        <field name="total_composants"/>
                        <field name="total_charges"/>
                        <field name="benefice" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View: gestion.buffet Search -->
    <record id="view_gestion_buffet_search" model="ir.ui.view">
        <field name="name">gestion.buffet.search</field>
        <field name="model">gestion.buffet</field>
        <field name="arch" type="xml">
            <search string="Recherche Buffets">
                <field name="name"/>
                <field name="client_name"/>
                <field name="place_id"/>
                <field name="pack_id"/>
                
                <separator/>
                <filter string="Brouillon" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmé" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Terminé" name="done" domain="[('state','=','done')]"/>
                
                <group expand="0" string="Grouper par">
                    <filter string="Client" name="group_client" context="{'group_by':'client_name'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'date'}"/>
                    <filter string="Pack" name="group_pack" context="{'group_by':'pack_id'}"/>
                    <filter string="Statut" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gestion_buffet" model="ir.actions.act_window">
        <field name="name">Buffets</field>
        <field name="res_model">gestion.buffet</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer un nouveau buffet
            </p>
        </field>
    </record>

</odoo>
