<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_project_management" model="ir.actions.report">
        <field name="name">Project Report</field>
        <field name="model">project.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_projet.report_project_document</field>
        <field name="report_file">gestion_projet.report_project_document</field>
        <field name="binding_model_id" ref="model_project_management"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_project_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2d2d2d; font-size: 11pt; line-height: 1.5;">

                        <!-- ══ EN-TÊTE ══ -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; border-bottom: 3px solid #714B67;">
                            <tr>
                                <td style="padding-bottom: 12px;">
                                    <div style="font-size: 8pt; font-weight: bold; letter-spacing: 1.5px; color: #714B67; text-transform: uppercase; margin-bottom: 4px;">
                                        Rapport de Projet
                                    </div>
                                    <div style="font-size: 18pt; font-weight: bold; color: #1a1a2e;">
                                        <span t-field="doc.name"/>
                                    </div>
                                </td>
                                <td style="text-align: right; vertical-align: bottom; padding-bottom: 14px;">
                                    <div style="font-size: 8pt; color: #888; text-transform: uppercase; letter-spacing: 1px;">Date d'émission</div>
                                    <div style="font-size: 10pt; font-weight: bold; color: #2d2d2d;">
                                        <span t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ CARTES RÉSUMÉ ══ -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 28px;">
                            <tr>
                                <!-- Carte Responsable -->
                                <td style="width: 48%; padding: 14px 18px; background-color: #714B67; border-radius: 6px; vertical-align: top;">
                                    <div style="font-size: 7.5pt; font-weight: bold; letter-spacing: 1.2px; color: #f2d9ec; text-transform: uppercase; margin-bottom: 5px;">
                                        Responsable du projet
                                    </div>
                                    <div style="font-size: 13pt; font-weight: bold; color: #ffffff;">
                                        <span t-field="doc.manager_id.name"/>
                                    </div>
                                </td>
                                <td style="width: 4%;"></td>
                                <!-- Carte Statistiques -->
                                <td style="width: 48%; padding: 14px 18px; background-color: #f5f0f4; border-left: 4px solid #714B67; border-radius: 0 6px 6px 0; vertical-align: top;">
                                    <div style="font-size: 7.5pt; font-weight: bold; letter-spacing: 1.2px; color: #714B67; text-transform: uppercase; margin-bottom: 5px;">
                                        Nombre de tâches
                                    </div>
                                    <div style="font-size: 22pt; font-weight: bold; color: #1a1a2e; line-height: 1;">
                                        <span t-esc="len(doc.task_ids)"/>
                                    </div>
                                    <div style="font-size: 9pt; color: #666; margin-top: 3px;">tâche(s) enregistrée(s)</div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ TITRE SECTION TÂCHES ══ -->
                        <div style="display: flex; align-items: center; margin-bottom: 12px;">
                            <div style="font-size: 11pt; font-weight: bold; color: #714B67; text-transform: uppercase; letter-spacing: 0.8px; border-bottom: 2px solid #714B67; padding-bottom: 4px;">
                                Liste des Tâches
                            </div>
                        </div>

                        <!-- ══ TABLEAU DES TÂCHES ══ -->
                        <table class="table table-sm o_main_table" style="width: 100%; border-collapse: collapse; font-size: 10pt;">
                            <thead>
                                <tr style="background-color: #1a1a2e; color: #ffffff;">
                                    <th style="padding: 10px 14px; text-align: left; font-size: 8pt; font-weight: bold; letter-spacing: 0.8px; text-transform: uppercase; border-radius: 4px 0 0 0;">#</th>
                                    <th style="padding: 10px 14px; text-align: left; font-size: 8pt; font-weight: bold; letter-spacing: 0.8px; text-transform: uppercase;">Désignation de la tâche</th>
                                    <th style="padding: 10px 14px; text-align: center; font-size: 8pt; font-weight: bold; letter-spacing: 0.8px; text-transform: uppercase;">Responsable</th>
                                    <th style="padding: 10px 14px; text-align: center; font-size: 8pt; font-weight: bold; letter-spacing: 0.8px; text-transform: uppercase;">Date début</th>
                                    <th style="padding: 10px 14px; text-align: center; font-size: 8pt; font-weight: bold; letter-spacing: 0.8px; text-transform: uppercase;">Date fin</th>
                                    <th style="padding: 10px 14px; text-align: center; font-size: 8pt; font-weight: bold; letter-spacing: 0.8px; text-transform: uppercase; border-radius: 0 4px 0 0;">Complexité</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.task_ids" t-as="task">
                                    <tr t-attf-style="background-color: {{ '#ffffff' if task_index % 2 == 0 else '#faf7f9' }}; border-bottom: 1px solid #e8e0e6;">
                                        <td style="padding: 9px 14px; color: #999; font-size: 9pt; font-weight: bold; text-align: left;">
                                            <span t-esc="task_index + 1"/>
                                        </td>
                                        <td style="padding: 9px 14px; font-weight: 600; color: #1a1a2e;">
                                            <span t-field="task.name"/>
                                        </td>
                                        <td style="padding: 9px 14px; text-align: center; color: #444;">
                                            <span t-field="task.manager_id.name"/>
                                        </td>
                                        <td style="padding: 9px 14px; text-align: center; color: #555; font-size: 9.5pt;">
                                            <span t-field="task.start_date"/>
                                        </td>
                                        <td style="padding: 9px 14px; text-align: center; color: #555; font-size: 9.5pt;">
                                            <span t-field="task.end_date"/>
                                        </td>
                                        <td style="padding: 9px 14px; text-align: center;">
                                            <!-- Badge Complexité -->
                                            <t t-if="task.complexity == 'Low'">
                                                <span style="display: inline-block; padding: 3px 14px; border-radius: 20px; font-size: 8pt; font-weight: bold; letter-spacing: 0.5px; background-color: #e6f4ea; color: #1e7e34; border: 1px solid #a8d5b5;">
                                                    Faible
                                                </span>
                                            </t>
                                            <t t-elif="task.complexity == 'Medium'">
                                                <span style="display: inline-block; padding: 3px 14px; border-radius: 20px; font-size: 8pt; font-weight: bold; letter-spacing: 0.5px; background-color: #fff8e1; color: #b07a00; border: 1px solid #ffe082;">
                                                    Moyenne
                                                </span>
                                            </t>
                                            <t t-elif="task.complexity == 'High'">
                                                <span style="display: inline-block; padding: 3px 14px; border-radius: 20px; font-size: 8pt; font-weight: bold; letter-spacing: 0.5px; background-color: #fce8e6; color: #c0392b; border: 1px solid #f5b7b1;">
                                                    Élevée
                                                </span>
                                            </t>
                                            <t t-else="">
                                                <span style="display: inline-block; padding: 3px 14px; border-radius: 20px; font-size: 8pt; font-weight: bold; background-color: #f0f0f0; color: #666;">
                                                    <span t-field="task.complexity"/>
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- ══ LÉGENDE ══ -->
                        <table style="width: 100%; margin-top: 16px; border-collapse: collapse;">
                            <tr>
                                <td style="font-size: 8pt; color: #999; padding-top: 4px;">
                                    <span style="font-weight: bold; color: #714B67;">Légende — Complexité : </span>
                                    <span style="background-color: #e6f4ea; color: #1e7e34; border: 1px solid #a8d5b5; padding: 1px 8px; border-radius: 10px; margin-right: 6px; font-size: 7.5pt; font-weight: bold;">Faible</span>
                                    <span style="background-color: #fff8e1; color: #b07a00; border: 1px solid #ffe082; padding: 1px 8px; border-radius: 10px; margin-right: 6px; font-size: 7.5pt; font-weight: bold;">Moyenne</span>
                                    <span style="background-color: #fce8e6; color: #c0392b; border: 1px solid #f5b7b1; padding: 1px 8px; border-radius: 10px; font-size: 7.5pt; font-weight: bold;">Élevée</span>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ PIED DE PAGE ══ -->
                        <div style="margin-top: 40px; border-top: 1px solid #e0d6e8; padding-top: 14px; text-align: center;">
                            <span style="font-size: 8pt; color: #aaa; letter-spacing: 0.5px;">
                                Document généré par le module Gestion de Projet — Soufiane Food
                            </span>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>