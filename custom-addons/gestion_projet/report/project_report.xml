<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_project_management" model="ir.actions.report">
        <field name="name">Project Report</field>
        <field name="model">project.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_projet.report_project_document</field>
        <field name="report_file">gestion_projet.report_project_document</field>
        <field name="print_report_name">'Project - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_project_management"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_project_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Project Report</h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Project Name:</strong>
                                <p t-field="doc.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Manager:</strong>
                                <p t-field="doc.manager_id.name"/>
                            </div>
                        </div>

                        <h3>Tasks</h3>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Task Name</th>
                                    <th>Manager</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Complexity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.task_ids" t-as="task">
                                    <tr>
                                        <td><span t-field="task.name"/></td>
                                        <td><span t-field="task.manager_id.name"/></td>
                                        <td><span t-field="task.start_date"/></td>
                                        <td><span t-field="task.end_date"/></td>
                                        <td><span t-field="task.complexity"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
