<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_project_management" model="ir.actions.report">
        <field name="name">Project Report</field>
        <field name="model">project.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gestion_projet.report_project_document</field>
        <field name="report_file">gestion_projet.report_project_document</field>
        <field name="binding_model_id" ref="model_project_management"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_project_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica', sans-serif; color: #333;">
                        
                        <div class="row mb-4" style="border-bottom: 3px solid #714B67; padding-bottom: 10px;">
                            <div class="col-8">
                                <h2 style="color: #714B67; font-weight: bold; text-transform: uppercase; margin: 0;">
                                    Rapport de Projet : <span t-field="doc.name"/>
                                </h2>
                            </div>
                            <div class="col-4 text-end align-bottom">
                                <span class="text-muted" style="font-size: 0.9em;">
                                    Émis le : <span t-esc="datetime.datetime.now().strftime('%d/%m/%Y')"/>
                                </span>
                            </div>
                        </div>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <div style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; border-left: 5px solid #714B67; height: 100%;">
                                    <strong style="color: #714B67; text-transform: uppercase; font-size: 0.8em;">Responsable du Projet</strong>
                                    <p class="mb-0" style="font-size: 1.2em; font-weight: 500;" t-field="doc.manager_id.name"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; border-left: 5px solid #dee2e6; height: 100%;">
                                    <strong style="color: #666; text-transform: uppercase; font-size: 0.8em;">Statistiques</strong>
                                    <p class="mb-0" style="font-size: 1.2em;">
                                        <span t-esc="len(doc.task_ids)"/> Tâche(s) enregistrée(s)
                                    </p>
                                </div>
                            </div>
                        </div>

                        <h4 class="mt-4 mb-3" style="color: #714B67; font-weight: bold;">
                            <i class="fa fa-tasks" style="margin-right: 10px;"/>Liste des Tâches
                        </h4>
                        
                        <table class="table table-sm o_main_table" style="border: 1px solid #dee2e6;">
                            <thead style="background-color: #714B67; color: white;">
                                <tr>
                                    <th class="text-start" style="padding: 10px;">Désignation de la Tâche</th>
                                    <th class="text-center" style="padding: 10px;">Responsable</th>
                                    <th class="text-center" style="padding: 10px;">Période</th>
                                    <th class="text-center" style="padding: 10px;">Complexité</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.task_ids" t-as="task">
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td class="align-middle" style="padding: 8px;">
                                            <span t-field="task.name" style="font-weight: 500;"/>
                                        </td>
                                        <td class="text-center align-middle">
                                            <span t-field="task.manager_id.name"/>
                                        </td>
                                        <td class="text-center align-middle" style="white-space: nowrap;">
                                            <div style="font-size: 0.9em;">
                                                <span t-field="task.start_date"/> 
                                                <i class="fa fa-long-arrow-right" style="margin: 0 5px; color: #714B67;"/> 
                                                <span t-field="task.end_date"/>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">
                                            <t t-set="bg_color" t-value="'#6c757d'"/>
                                            <t t-if="task.complexity == 'Low'" t-set="bg_color" t-value="'#28a745'"/> <t t-if="task.complexity == 'Medium'" t-set="bg_color" t-value="'#ffc107'"/> <t t-if="task.complexity == 'High'" t-set="bg_color" t-value="'#dc3545'"/> <span t-field="task.complexity" 
                                                  t-attf-style="background-color: {{bg_color}}; color: white; padding: 4px 12px; border-radius: 15px; font-size: 0.8em; font-weight: bold; display: inline-block; min-width: 70px;"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="footer text-center text-muted" style="font-size: 0.8em; margin-top: 50px; border-top: 1px solid #eee; padding-top: 20px;">
                            <p>Document généré par le module Gestion de Projet Odoo - Soufiane Food.</p>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>