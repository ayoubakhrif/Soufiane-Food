<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_management_form" model="ir.ui.view">
        <field name="name">project.management.form</field>
        <field name="model">project.management</field>
        <field name="arch" type="xml">
            <form string="Project management">
                <header>
                    <button name="action_generate_report" type="object" string="Generate Report" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks">
                            <field name="task_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="manager_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="complexity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_management_tree" model="ir.ui.view">
        <field name="name">project.management.tree</field>
        <field name="model">project.management</field>
        <field name="arch" type="xml">
            <tree string="Projects">
                <field name="name"/>
                <field name="manager_id"/>
            </tree>
        </field>
    </record>

    <record id="action_project_management" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.management</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Top Menu -->
    <menuitem id="menu_project_management_root" name="Gestion de Projet" sequence="10"/>
    <menuitem id="menu_project_management" name="Projects" parent="menu_project_management_root" action="action_project_management" sequence="10"/>
</odoo>
