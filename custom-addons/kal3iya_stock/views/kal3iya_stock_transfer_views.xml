<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kal3iya_stock_transfer_tree" model="ir.ui.view">
        <field name="name">kal3iya.stock.transfer.tree</field>
        <field name="model">kal3iya.stock.transfer</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="garage_source"/>
                <field name="garage_dest"/>
                <field name="qty"/>
                <field name="weight"/>
                <field name="tonnage"/>
                <field name="agent_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_kal3iya_stock_transfer_form" model="ir.ui.view">
        <field name="name">kal3iya.stock.transfer.form</field>
        <field name="model">kal3iya.stock.transfer</field>
        <field name="arch" type="xml">
            <form string="Transfert Stock entre Garages">
                <header>
                    <button name="action_confirm" string="Confirmer le Transfert" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Annuler (Reversal)" type="object" class="btn-danger" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Article &amp; Lot">
                            <field name="product_id" options="{'no_create_edit': True}"/>
                            <field name="lot"/>
                            <field name="dum"/>
                            <field name="calibre"/>
                            <field name="ste_id" options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Quantités &amp; Date">
                            <field name="qty"/>
                            <field name="weight"/>
                            <field name="tonnage"/>
                            <field name="date"/>
                            <field name="agent_id" options="{'no_create_edit': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Source (Départ)">
                            <field name="garage_source"/>
                            <field name="frigo_source"/>
                        </group>
                        <group string="Destination (Arrivée)">
                            <field name="garage_dest"/>
                            <field name="frigo_dest"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter" groups="kal3iya_stock.group_manager">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_kal3iya_stock_transfer" model="ir.actions.act_window">
        <field name="name">Transferts entre Garages</field>
        <field name="res_model">kal3iya.stock.transfer</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
