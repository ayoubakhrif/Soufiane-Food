<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_document_config_form" model="ir.ui.view">
        <field name="name">logistique.document.config.form</field>
        <field name="model">logistique.document.config</field>
        <field name="arch" type="xml">
            <form string="Configuration Document">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Sélectionner le document..."/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Champs Requis" name="fields">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_document_config_tree" model="ir.ui.view">
        <field name="name">logistique.document.config.tree</field>
        <field name="model">logistique.document.config</field>
        <field name="arch" type="xml">
            <tree string="Configurations Documents">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_document_config" model="ir.actions.act_window">
        <field name="name">Configuration Documents</field>
        <field name="res_model">logistique.document.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle configuration de document
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_document_config"
              name="Configuration Documents"
              parent="logistique.menu_logistique_config_settings"
              action="action_document_config"
              sequence="20"/>
</odoo>
