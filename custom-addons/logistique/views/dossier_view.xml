<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistique_dossier_form" model="ir.ui.view">
        <field name="name">logistique.dossier.form</field>
        <field name="model">logistique.dossier</field>
        <field name="arch" type="xml">
            <form string="Dossier Logistique">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group string="Numéros Finance (Lecture seule)">
                            <field name="prov_number" readonly="1"/>
                            <field name="def_number" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conteneurs">
                            <field name="entry_ids" readonly="1">
                                <tree>
                                    <field name="bl_number" string="BL"/>
                                    <field name="container_names" string="Conteneurs"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chèques">
                            <field name="cheque_ids">
                                <tree>
                                    <field name="cheque_serie"/>
                                    <field name="date"/>
                                    <field name="beneficiary_id"/>
                                    <field name="type"/>
                                    <field name="amount"/>
                                    <field name="ste_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Déductions">
                            <field name="deduction_ids">
                                <tree editable="bottom">
                                    <field name="dossier_id" column_invisible="1"/>
                                    <field name="date"/>
                                    <field name="beneficiary_id"/>
                                    <field name="type"/>
                                    <field name="amount"/>
                                    <field name="ste_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Sutra">
                            <field name="sutra_ids">
                                <tree editable="bottom">
                                    <field name="dossier_id" column_invisible="1"/>
                                    <field name="amount"/>
                                    <field name="invoice"/>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="type"/>
                                    <field name="beneficiary_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistique_dossier_tree" model="ir.ui.view">
        <field name="name">logistique.dossier.tree</field>
        <field name="model">logistique.dossier</field>
        <field name="arch" type="xml">
            <tree string="Dossiers Logistiques">
                <field name="name"/>
                <field name="container_names" string="Conteneur" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_logistique_dossier_search" model="ir.ui.view">
        <field name="name">logistique.dossier.search</field>
        <field name="model">logistique.dossier</field>
        <field name="arch" type="xml">
            <search string="Recherche Dossiers">
                <field name="name"/>
                <field name="container_names" string="Conteneur"/>
                <field name="prov_number"/>
                <field name="def_number"/>
                <field name="cheque_ids" string="Numéro Chèque" filter_domain="[('cheque_ids.cheque_serie', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_logistique_dossier" model="ir.actions.act_window">
        <field name="name">Dossiers / BL</field>
        <field name="res_model">logistique.dossier</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_logistique_dossier"
              name="Dossiers"
              parent="menu_logistique_root"
              action="action_logistique_dossier"
              sequence="15"/>
</odoo>
