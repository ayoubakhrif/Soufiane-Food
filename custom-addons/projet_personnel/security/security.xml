<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_projet_personnel">
            <field name="name">Projet Personnel</field>
            <field name="description">Gestion des articles, stock et ventes.</field>
            <field name="sequence">1</field>
        </record>

        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_projet_personnel"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_projet_personnel"/>
            <field name="implied_ids" eval="[(4, ref('projet_personnel.group_user'))]"/>
        </record>
    </data>
</odoo>
