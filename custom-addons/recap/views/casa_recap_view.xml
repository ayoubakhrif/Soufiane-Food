<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_casa_recap_tree" model="ir.ui.view">
        <name>casa.recap.tree</name>
        <model>casa.recap</model>
        <arch type="xml">
            <tree string="Récapitulatifs">
                <field name="date"/>
                <field name="total_stock_casa" sum="Total"/>
                <field name="total_stock_tanger" sum="Total"/>
                <field name="total_benefices" sum="Total"/>
                <field name="total_perte" sum="Total"/>
                <field name="total_charges" sum="Total"/>
                <field name="credits_clients" sum="Total"/>
            </tree>
        </arch>
    </record>

    <record id="view_casa_recap_form" model="ir.ui.view">
        <name>casa.recap.form</name>
        <model>casa.recap</model>
        <arch type="xml">
            <form string="Récapitulatif">
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>

                    <!-- Dashboard Style Cards -->
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; margin-bottom: 30px;">
                        <!-- Stock Casa -->
                        <div style="background: #f0f7ff; padding: 20px; border-radius: 12px; border: 1px solid #d1e9ff; text-align: center;">
                            <div style="color: #007bff; font-size: 14px; font-weight: bold; margin-bottom: 10px;">STOCK CASA</div>
                            <div style="font-size: 24px; font-weight: 800; color: #0056b3;">
                                <field name="total_stock_casa"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Stock Tanger -->
                        <div style="background: #f0f7ff; padding: 20px; border-radius: 12px; border: 1px solid #d1e9ff; text-align: center;">
                            <div style="color: #007bff; font-size: 14px; font-weight: bold; margin-bottom: 10px;">STOCK TANGER</div>
                            <div style="font-size: 24px; font-weight: 800; color: #0056b3;">
                                <field name="total_stock_tanger"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Bénéfices -->
                        <div style="background: #f6ffed; padding: 20px; border-radius: 12px; border: 1px solid #b7eb8f; text-align: center;">
                            <div style="color: #52c41a; font-size: 14px; font-weight: bold; margin-bottom: 10px;">TOTAL BÉNÉFICES</div>
                            <div style="font-size: 24px; font-weight: 800; color: #237804;">
                                <field name="total_benefices"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Pertes -->
                        <div style="background: #fff1f0; padding: 20px; border-radius: 12px; border: 1px solid #ffa39e; text-align: center;">
                            <div style="color: #f5222d; font-size: 14px; font-weight: bold; margin-bottom: 10px;">TOTAL PERTES</div>
                            <div style="font-size: 24px; font-weight: 800; color: #a8071a;">
                                <field name="total_perte"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Charges -->
                        <div style="background: #fffbe6; padding: 20px; border-radius: 12px; border: 1px solid #ffe58f; text-align: center;">
                            <div style="color: #faad14; font-size: 14px; font-weight: bold; margin-bottom: 10px;">TOTAL CHARGES</div>
                            <div style="font-size: 24px; font-weight: 800; color: #ad6800;">
                                <field name="total_charges"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Crédits Clients -->
                        <div style="background: #f9f0ff; padding: 20px; border-radius: 12px; border: 1px solid #d3adf7; text-align: center;">
                            <div style="color: #722ed1; font-size: 14px; font-weight: bold; margin-bottom: 10px;">CRÉDITS CLIENTS</div>
                            <div style="font-size: 24px; font-weight: 800; color: #391085;">
                                <field name="credits_clients"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Charges" name="charges">
                            <field name="charge_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="ville"/>
                                    <field name="client_id"/>
                                    <field name="total_amount" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Versements" name="versements">
                            <field name="versement_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="payment_mode"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Virements" name="virements">
                            <field name="virement_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="payment_mode"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chèques" name="cheques">
                            <field name="cheque_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="payment_mode"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </arch>
    </record>

    <record id="action_casa_recap" model="ir.actions.act_window">
        <name>Récapitulatif Quotidien</name>
        <res_model>casa.recap</res_model>
        <view_mode>tree,form</view_mode>
        <help type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez une nouvelle récapitulation quotidienne.
            </p>
        </help>
    </record>

    <menuitem id="menu_recap_root" name="Recap" sequence="50" web_icon="recap,static/description/icon.png"/>
    <menuitem id="menu_recap_main" name="Récapitulatif" parent="menu_recap_root" action="action_casa_recap" sequence="10"/>

</odoo>
