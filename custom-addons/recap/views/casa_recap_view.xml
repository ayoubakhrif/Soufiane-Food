<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_casa_recap_tree" model="ir.ui.view">
        <field name="name">casa.recap.tree</field>
        <field name="model">casa.recap</field>
        <field name="arch" type="xml">
            <tree string="Récapitulatifs">
                <field name="date"/>
                <field name="total_stock_casa" sum="Total"/>
                <field name="total_stock_tanger" sum="Total"/>
                <field name="total_benefice_casa" sum="Total"/>
                <field name="total_benefice_tanger" sum="Total"/>
                <field name="total_perte_casa" sum="Total"/>
                <field name="total_perte_tanger" sum="Total"/>
                <field name="total_charges" sum="Total"/>
                <field name="total_avances" sum="Total"/>
                <field name="credits_clients" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_casa_recap_form" model="ir.ui.view">
        <field name="name">casa.recap.form</field>
        <field name="model">casa.recap</field>
        <field name="arch" type="xml">
            <form string="Récapitulatif">
                <header>
                    <button name="action_recalculate" string="Recalculer" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>

                    <!-- Dashboard Style Cards -->
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; margin-bottom: 30px;">
                        <!-- Stock Casa -->
                        <div style="background: #f0f7ff; padding: 20px; border-radius: 12px; border: 1px solid #d1e9ff; text-align: center;">
                            <div style="color: #007bff; font-size: 14px; font-weight: bold; margin-bottom: 10px;">STOCK CASA</div>
                            <div style="font-size: 24px; font-weight: 800; color: #0056b3;">
                                <field name="total_stock_casa"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Stock Tanger -->
                        <div style="background: #f0f7ff; padding: 20px; border-radius: 12px; border: 1px solid #d1e9ff; text-align: center;">
                            <div style="color: #007bff; font-size: 14px; font-weight: bold; margin-bottom: 10px;">STOCK TANGER</div>
                            <div style="font-size: 24px; font-weight: 800; color: #0056b3;">
                                <field name="total_stock_tanger"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Bénéfices Casa -->
                        <div style="background: #f6ffed; padding: 20px; border-radius: 12px; border: 1px solid #b7eb8f; text-align: center;">
                            <div style="color: #52c41a; font-size: 14px; font-weight: bold; margin-bottom: 10px;">BÉNÉFICES CASA</div>
                            <div style="font-size: 24px; font-weight: 800; color: #237804;">
                                <field name="total_benefice_casa"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Bénéfices Tanger -->
                        <div style="background: #f6ffed; padding: 20px; border-radius: 12px; border: 1px solid #b7eb8f; text-align: center;">
                            <div style="color: #52c41a; font-size: 14px; font-weight: bold; margin-bottom: 10px;">BÉNÉFICES TANGER</div>
                            <div style="font-size: 24px; font-weight: 800; color: #237804;">
                                <field name="total_benefice_tanger"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Pertes Casa -->
                        <div style="background: #fff1f0; padding: 20px; border-radius: 12px; border: 1px solid #ffa39e; text-align: center;">
                            <div style="color: #f5222d; font-size: 14px; font-weight: bold; margin-bottom: 10px;">PERTES CASA</div>
                            <div style="font-size: 24px; font-weight: 800; color: #a8071a;">
                                <field name="total_perte_casa"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Pertes Tanger -->
                        <div style="background: #fff1f0; padding: 20px; border-radius: 12px; border: 1px solid #ffa39e; text-align: center;">
                            <div style="color: #f5222d; font-size: 14px; font-weight: bold; margin-bottom: 10px;">PERTES TANGER</div>
                            <div style="font-size: 24px; font-weight: 800; color: #a8071a;">
                                <field name="total_perte_tanger"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Charges -->
                        <div style="background: #fffbe6; padding: 20px; border-radius: 12px; border: 1px solid #ffe58f; text-align: center;">
                            <div style="color: #faad14; font-size: 14px; font-weight: bold; margin-bottom: 10px;">TOTAL CHARGES CASA</div>
                            <div style="font-size: 24px; font-weight: 800; color: #ad6800;">
                                <field name="total_charges"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Crédits Clients -->
                        <div style="background: #f9f0ff; padding: 20px; border-radius: 12px; border: 1px solid #d3adf7; text-align: center;">
                            <div style="color: #722ed1; font-size: 14px; font-weight: bold; margin-bottom: 10px;">CRÉDITS CLIENTS (PROV)</div>
                            <div style="font-size: 24px; font-weight: 800; color: #391085;">
                                <field name="credits_clients"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Total Avances -->
                        <div style="background: #e6fffa; padding: 20px; border-radius: 12px; border: 1px solid #81e6d9; text-align: center;">
                            <div style="color: #319795; font-size: 14px; font-weight: bold; margin-bottom: 10px;">TOTAL AVANCES</div>
                            <div style="font-size: 24px; font-weight: 800; color: #234e52;">
                                <field name="total_avances"/>
                                <span style="font-size: 14px; font-weight: normal; margin-left: 5px;">MAD</span>
                            </div>
                        </div>
                        <!-- Avances Casa -->
                        <div style="background: #e6fffa; padding: 15px; border-radius: 12px; border: 1px solid #81e6d9; text-align: center;">
                            <div style="color: #319795; font-size: 12px; font-weight: bold; margin-bottom: 10px;">AVANCES CASA</div>
                            <div style="font-size: 20px; font-weight: 800; color: #234e52;">
                                <field name="total_avances_casa"/>
                            </div>
                        </div>
                        <!-- Avances Tanger -->
                        <div style="background: #e6fffa; padding: 15px; border-radius: 12px; border: 1px solid #81e6d9; text-align: center;">
                            <div style="color: #319795; font-size: 12px; font-weight: bold; margin-bottom: 10px;">AVANCES TANGER</div>
                            <div style="font-size: 20px; font-weight: 800; color: #234e52;">
                                <field name="total_avances_tanger"/>
                            </div>
                        </div>
                        <!-- Avances Kenitra -->
                        <div style="background: #e6fffa; padding: 15px; border-radius: 12px; border: 1px solid #81e6d9; text-align: center;">
                            <div style="color: #319795; font-size: 12px; font-weight: bold; margin-bottom: 10px;">AVANCES KÉNITRA</div>
                            <div style="font-size: 20px; font-weight: 800; color: #234e52;">
                                <field name="total_avances_kenitra"/>
                            </div>
                        </div>
                        <!-- Avances Agadir -->
                        <div style="background: #e6fffa; padding: 15px; border-radius: 12px; border: 1px solid #81e6d9; text-align: center;">
                            <div style="color: #319795; font-size: 12px; font-weight: bold; margin-bottom: 10px;">AVANCES AGADIR</div>
                            <div style="font-size: 20px; font-weight: 800; color: #234e52;">
                                <field name="total_avances_agadir"/>
                            </div>
                        </div>
                        <!-- Avances Marrakech -->
                        <div style="background: #e6fffa; padding: 15px; border-radius: 12px; border: 1px solid #81e6d9; text-align: center;">
                            <div style="color: #319795; font-size: 12px; font-weight: bold; margin-bottom: 10px;">AVANCES MARRAKECH</div>
                            <div style="font-size: 20px; font-weight: 800; color: #234e52;">
                                <field name="total_avances_marrakech"/>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Charges" name="charges">
                            <field name="charge_line_ids" readonly="1">
                                <tree>
                                    <field name="client_id" string="Client" optional="show"/>
                                    <field name="type"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="comment"/>
                                    <field name="ville"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Versements" name="versements">
                            <field name="versement_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="ville"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="payment_mode"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Virements" name="virements">
                            <field name="virement_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="ville"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="payment_mode"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chèques" name="cheques">
                            <field name="cheque_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="ville"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="payment_mode"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_casa_recap" model="ir.actions.act_window">
        <field name="name">Récapitulatif Quotidien</field>
        <field name="res_model">casa.recap</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez une nouvelle récapitulation quotidienne.
            </p>
        </field>
    </record>

    <menuitem id="menu_recap_root" name="Recap" sequence="50" web_icon="recap,static/description/icon.png" groups="group_recap_user"/>
    <menuitem id="menu_recap_main" name="Récapitulatif" parent="menu_recap_root" action="action_casa_recap" sequence="10"/>

</odoo>
