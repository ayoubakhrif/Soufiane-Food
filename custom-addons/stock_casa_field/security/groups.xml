<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_casa_field_stock_category" model="ir.module.category">
        <field name="name">Gestion Stock Terrain</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_viewer" model="res.groups">
        <field name="name">Lecteur</field>
        <field name="category_id" ref="module_casa_field_stock_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">Agent Terrain</field>
        <field name="category_id" ref="module_casa_field_stock_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Responsable Stock</field>
        <field name="category_id" ref="module_casa_field_stock_category"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

