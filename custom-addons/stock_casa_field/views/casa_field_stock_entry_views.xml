<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_casa_field_stock_entry_tree" model="ir.ui.view">
        <field name="name">casa_field.stock.entry.tree</field>
        <field name="model">casa_field.stock.entry</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'">
                <field name="date"/>
                <field name="name"/>
                <field name="company_article_id"/>
                <field name="product_id"/>
                                <field name="qty"/>
                <field name="weight"/>
                <field name="tonnage"/>
                <field name="price_purchase"/>
                <field name="garage"/>
                <field name="frigo"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_casa_field_stock_entry_form" model="ir.ui.view">
        <field name="name">casa_field.stock.entry.form</field>
        <field name="model">casa_field.stock.entry</field>
        <field name="arch" type="xml">
            <form string="EntrÃ©e Stock Casa">
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Annuler (Reversal)" type="object" class="btn-danger" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancel"/>
                </header>
                <sheet>
                    <div class="alert alert-info border-0 mb-4" role="alert" invisible="state != 'done'">
                        <i class="fa fa-info-circle me-2"/>
                        <strong>Attention:</strong> Les opÃ©rations confirmÃ©es ne peuvent pas Ãªtre modifiÃ©es. Pour corriger une erreur, utilisez le bouton <strong>Annuler (Reversal)</strong> et crÃ©ez une nouvelle opÃ©ration.
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    
                    <separator string="Produit &amp; QuantitÃ©s"/>
                    <group>
                        <group>
                            <field name="product_id" options="{'no_create_edit': True}"/>
                            <field name="qty"/>
                            <field name="weight"/>
                            <field name="tonnage"/>
                        </group>
                        <group>
                            <field name="price_purchase"/>
                            <field name="date"/>
                        </group>
                    </group>

                    <separator string="Logistique &amp; TraÃ§abilitÃ©"/>
                    <group>
                        <group>
                            <field name="garage"/>
                            <field name="frigo"/>
                                                        <field name="lot"/>
                            <field name="dum"/>
                        </group>
                        <group>
                            <field name="calibre"/>
                            <field name="driver_id" options="{'no_create_edit': True}"/>
                        </group>
                    </group>

                    <separator string="Photos de RÃ©ception"/>
                    <group>
                        <group string="Emballage">
                            <field name="photo_packaging" widget="image" class="oe_avatar"/>
                        </group>
                        <group string="Conteneur">
                            <field name="photo_container" widget="image" class="oe_avatar"/>
                        </group>
                    </group>

                    <separator string="Image Article"/>
                    <group>
                        <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    </group>
                </sheet>
                <div class="oe_chatter" groups="stock_casa_field.group_manager">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_casa_field_stock_entry_search" model="ir.ui.view">
        <field name="name">casa_field.stock.entry.search</field>
        <field name="model">casa_field.stock.entry</field>
        <field name="arch" type="xml">
            <search string="Recherche EntrÃ©es">
                <field name="name"/>
                <field name="product_id"/>
                                <field name="lot"/>
                <field name="dum"/>
                <separator/>
                <filter string="Brouillon" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="ConfirmÃ©" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Aujourd'hui" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Ce mois" name="this_month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Produit" name="group_product" context="{'group_by': 'product_id'}"/>
                                        <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Ã‰tat" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_casa_field_stock_entry" model="ir.actions.act_window">
        <field name="name">EntrÃ©es Stock Casa</field>
        <field name="res_model">casa_field.stock.entry</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

