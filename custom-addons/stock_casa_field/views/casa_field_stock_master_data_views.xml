<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Views -->
    <record id="view_casa_field_stock_product_tree" model="ir.ui.view">
        <field name="name">casa_field.stock.product.tree</field>
        <field name="model">casa_field.stock.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_article_id"/>
            </tree>
        </field>
    </record>

    <record id="view_casa_field_stock_product_form" model="ir.ui.view">
        <field name="name">casa_field.stock.product.form</field>
        <field name="model">casa_field.stock.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_emballage" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom interne Casa..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_article_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Product Action -->
    <record id="action_casa_field_stock_product" model="ir.actions.act_window">
        <field name="name">Produits</field>
        <field name="res_model">casa_field.stock.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Client Action -->
    <record id="action_casa_field_stock_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">casa_field.stock.client</field>
        <field name="view_mode">tree,form</field>
    </record>

        <!-- Driver Views -->
    <record id="view_casa_field_stock_driver_tree" model="ir.ui.view">
        <field name="name">casa_field.stock.driver.tree</field>
        <field name="model">casa_field.stock.driver</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="phone"/>
                <field name="password"/>
            </tree>
        </field>
    </record>

    <record id="view_casa_field_stock_driver_form" model="ir.ui.view">
        <field name="name">casa_field.stock.driver.form</field>
        <field name="model">casa_field.stock.driver</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="phone"/>
                            <field name="password" password="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Driver Action -->
    <record id="action_casa_field_stock_driver" model="ir.actions.act_window">
        <field name="name">Chauffeurs</field>
        <field name="res_model">casa_field.stock.driver</field>
        <field name="view_mode">tree,form</field>
    </record>

    </odoo>
