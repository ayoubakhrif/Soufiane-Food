<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Return Tree View -->
    <record id="view_casa_field_stock_return_tree" model="ir.ui.view">
        <field name="name">casa_field.stock.return.tree</field>
        <field name="model">casa_field.stock.return</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="exit_id"/>
                <field name="product_id"/>
                <field name="client_id"/>
                <field name="qty"/>
                <field name="weight"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Return Form View -->
    <record id="view_casa_field_stock_return_form" model="ir.ui.view">
        <field name="name">casa_field.stock.return.form</field>
        <field name="model">casa_field.stock.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirmer" invisible="state != 'draft'" class="oe_highlight" groups="casa_field_stock.group_manager"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state != 'done'" groups="casa_field_stock.group_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="exit_id" readonly="state != 'draft'" options="{'no_create_edit': True}"/>
                            <field name="product_id"/>
                            <field name="client_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="qty" readonly="state != 'draft'"/>
                            <field name="weight" readonly="state != 'draft'"/>
                            <field name="lot"/>
                            <field name="dum"/>
                        </group>
                        <group>
                            <field name="garage"/>
                            <field name="frigo"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Return Action -->
    <record id="action_casa_field_stock_return" model="ir.actions.act_window">
        <field name="name">Retours Clients</field>
        <field name="res_model">casa_field.stock.return</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                CrÃ©er un nouveau retour client
            </p>
        </field>
    </record>
</odoo>

