<?xml version="1.0" encoding="utf-8"?>
<odoo>
        

    <record id="view_kal3iya_stock_stock_tree" model="ir.ui.view">
        <field name="name">kal3iya.stock.stock.tree</field>
        <field name="model">kal3iya.stock.stock</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="garage"/>
                <field name="frigo"/>
                                <field name="quantity" sum="Total QuantitÃ©"/>
                <field name="weight"/>
                <field name="price"/>
                <field name="mt_achat" sum="Total Mt Achat"/>
            </tree>
        </field>
    </record>

    <record id="view_kal3iya_stock_stock_form" model="ir.ui.view">
        <field name="name">kal3iya.stock.stock.form</field>
        <field name="model">kal3iya.stock.stock</field>
        <field name="arch" type="xml">
            <form string="Ligne de Stock" create="false" edit="false">
                <header>
                    <button name="action_new_exit" string="Nouvelle Sortie" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="DÃ©tails Stock">
                            <field name="quantity"/>
                            <field name="weight"/>
                            <field name="calibre"/>
                            <field name="lot"/>
                            <field name="dum"/>
                        </group>
                        <group string="Localisation &amp; Finance">
                            <field name="garage"/>
                            <field name="frigo"/>
                                                        <field name="price"/>
                            <field name="mt_achat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kal3iya_stock_stock_graph" model="ir.ui.view">
        <field name="name">kal3iya.stock.stock.graph</field>
        <field name="model">kal3iya.stock.stock</field>
        <field name="arch" type="xml">
            <graph string="Stock Analysis" type="bar">
                <field name="product_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="weight" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_kal3iya_stock_stock_pivot" model="ir.ui.view">
        <field name="name">kal3iya.stock.stock.pivot</field>
        <field name="model">kal3iya.stock.stock</field>
        <field name="arch" type="xml">
            <pivot string="Stock Analysis">
                <field name="garage" type="row"/>
                <field name="product_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="weight" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_kal3iya_stock_stock_search" model="ir.ui.view">
        <field name="name">kal3iya.stock.stock.search</field>
        <field name="model">kal3iya.stock.stock</field>
        <field name="arch" type="xml">
            <search string="Recherche Stock">
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="garage"/>
                <field name="frigo"/>
                                <field name="calibre"/>
                
                <filter string="En Stock" name="in_stock" domain="[('quantity', '>', 0)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Produit" name="group_product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Garage" name="group_garage" domain="[]" context="{'group_by': 'garage'}"/>
                    <filter string="Frigo" name="group_frigo" domain="[]" context="{'group_by': 'frigo'}"/>
                                        <filter string="Calibre" name="group_calibre" domain="[]" context="{'group_by': 'calibre'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kal3iya_stock_stock" model="ir.actions.act_window">
        <field name="name">Stock Kal3iya</field>
        <field name="res_model">kal3iya.stock.stock</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun stock disponible.
            </p>
        </field>
    </record>

    <!-- Adding "New Exit" to the Action menu of the Stock view -->
    <record id="action_new_exit_binding" model="ir.actions.server">
        <field name="name">Nouvelle Sortie</field>
        <field name="model_id" ref="model_kal3iya_stock_stock"/>
        <field name="binding_model_id" ref="model_kal3iya_stock_stock"/>
        <field name="binding_view_types">kanban,list</field>
        <field name="state">code</field>
        <field name="code">
        if records:
            action = records[0].action_new_exit()
        </field>
    </record>

</odoo>




