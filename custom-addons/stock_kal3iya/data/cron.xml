<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- CRON: Sync DUM PDFs from Drive -->
        <record id="cron_sync_dum_drive_stock_kal3iya" model="ir.cron">
            <field name="name">Stock Kal3iya: Sync DUM Drive Links</field>
            <field name="model_id" ref="model_stock_kal3iya_stock"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_dum_drive()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <!-- Run at 20:00 UTC -->
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 20:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
