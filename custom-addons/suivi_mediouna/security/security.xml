<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Catégorie pour le module Suivi Mediouna -->
        <record model="ir.module.category" id="module_category_suivi_mediouna">
            <field name="name">Suivi Mediouna</field>
            <field name="description">Gestion des accès pour le module Suivi Mediouna</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groupe Utilisateur -->
        <record id="group_suivi_mediouna_user" model="res.groups">
            <field name="name">Utilisateur</field>
            <field name="category_id" ref="module_category_suivi_mediouna"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Peut consulter et créer des records de production et présences.</field>
        </record>

        <!-- Groupe Administrateur/Manager -->
        <record id="group_suivi_mediouna_manager" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_suivi_mediouna"/>
            <field name="implied_ids" eval="[(4, ref('group_suivi_mediouna_user'))]"/>
            <field name="comment">Accès complet à la configuration et aux rapports financiers.</field>
        </record>
    </data>
</odoo>
