<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_suivi_mediouna_daily_report_tree" model="ir.ui.view">
        <field name="name">suivi_mediouna.daily_report.tree</field>
        <field name="model">suivi_mediouna.daily_report</field>
        <field name="arch" type="xml">
            <tree string="Rapports Journaliers">
                <field name="date"/>
                <field name="production_jour" sum="Total Production"/>
                <field name="charges_jour" sum="Total Charges"/>
                <field name="benefice" sum="Total Bénéfice"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_mediouna_daily_report_form" model="ir.ui.view">
        <field name="name">suivi_mediouna.daily_report.form</field>
        <field name="model">suivi_mediouna.daily_report</field>
        <field name="arch" type="xml">
            <form string="Rapport Journalier">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="date" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="production_jour"/>
                            <field name="charges_jour"/>
                        </group>
                        <group>
                            <field name="benefice"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_suivi_mediouna_daily_report_graph" model="ir.ui.view">
        <field name="name">suivi_mediouna.daily_report.graph</field>
        <field name="model">suivi_mediouna.daily_report</field>
        <field name="arch" type="xml">
            <graph string="Analyse des Bénéfices" type="bar">
                <field name="date" type="row"/>
                <field name="benefice" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_suivi_mediouna_daily_report" model="ir.actions.act_window">
        <field name="name">Rapports Journaliers</field>
        <field name="res_model">suivi_mediouna.daily_report</field>
        <field name="view_mode">tree,form,graph</field>
    </record>
</odoo>
