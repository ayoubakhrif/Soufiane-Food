<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================= -->
    <!-- 📋 Form View -->
    <!-- ========================= -->
    <record id="view_expense_daily_form" model="ir.ui.view">
        <field name="name">suivi.expense.daily.form</field>
        <field name="model">suivi.expense.daily</field>
        <field name="arch" type="xml">
            <form string="Dépense Quotidienne">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="month_period" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description optionnelle..."/>
                    </group>
                    <group string="Facture / Reçu de caisse">
                        <field name="receipt_filename" invisible="1"/>
                        <field name="receipt_image" widget="image" class="oe_avatar" options="{'zoom': true, 'preview_image': 'receipt_image'}" filename="receipt_filename"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 🌳 Tree View -->
    <!-- ========================= -->
    <record id="view_expense_daily_tree" model="ir.ui.view">
        <field name="name">suivi.expense.daily.tree</field>
        <field name="model">suivi.expense.daily</field>
        <field name="arch" type="xml">
            <tree string="Dépenses Quotidiennes">
                <field name="date"/>
                <field name="category_id"/>
                <field name="amount" sum="Total"/>
                <field name="has_receipt" widget="boolean" string="Reçu 🧾"/>
                <field name="month_period"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 📊 Pivot View -->
    <!-- ========================= -->
    <record id="view_expense_daily_pivot" model="ir.ui.view">
        <field name="name">suivi.expense.daily.pivot</field>
        <field name="model">suivi.expense.daily</field>
        <field name="arch" type="xml">
            <pivot string="Analyse Dépenses Quotidiennes">
                <field name="month_period" type="row"/>
                <field name="category_id" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 📈 Graph View -->
    <!-- ========================= -->
    <record id="view_expense_daily_graph" model="ir.ui.view">
        <field name="name">suivi.expense.daily.graph</field>
        <field name="model">suivi.expense.daily</field>
        <field name="arch" type="xml">
            <graph string="Graphique Dépenses Quotidiennes" type="bar">
                <field name="month_period"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 🔍 Search View -->
    <!-- ========================= -->
    <record id="view_expense_daily_search" model="ir.ui.view">
        <field name="name">suivi.expense.daily.search</field>
        <field name="model">suivi.expense.daily</field>
        <field name="arch" type="xml">
            <search string="Rechercher Dépenses">
                <field name="category_id"/>
                <field name="date"/>
                <separator/>
                <filter string="Ce mois" name="this_month" 
                        domain="[('date','&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Période" name="group_period" context="{'group_by':'month_period'}"/>
                    <filter string="Catégorie" name="group_category" context="{'group_by':'category_id'}"/>
                    <filter string="Année" name="group_year" context="{'group_by':'year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================= -->
    <!-- 🚀 Action -->
    <!-- ========================= -->
    <record id="action_expense_daily" model="ir.actions.act_window">
        <field name="name">Dépenses Quotidiennes</field>
        <field name="res_model">suivi.expense.daily</field>
        <field name="view_mode">tree,form,pivot,graph</field>
    </record>
</odoo>
