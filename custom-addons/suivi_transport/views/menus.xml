              sequence="20"/>

    <menuitem id="menu_suivi_stock_move"
              name="Mouvements de Stock"
              parent="menu_suivi_transport_stock"
              action="action_suivi_stock_move"
              sequence="30"/>

    <!-- Mirror Menu in Stock Casa -->
    <menuitem id="menu_casa_stock_suivi_transport"
              name="Suivi Transport"
              parent="casa_stock.menu_casa_stock_root"
              action="action_suivi_operation"
              sequence="48"/>
