    <menuitem id="menu_suivi_transport_stock"
              name="Stock"
              parent="menu_suivi_transport_root"
              sequence="15"/>

    <menuitem id="menu_suivi_stock_stock"
              name="État du Stock"
              parent="menu_suivi_transport_stock"
              action="action_suivi_stock_stock"
              sequence="10"/>

    <menuitem id="menu_suivi_stock_entry"
              name="Entrées"
              parent="menu_suivi_transport_stock"
