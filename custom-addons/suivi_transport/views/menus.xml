<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_suivi_transport_root"
              name="Suivi Transport"
              web_icon="suivi_transport,static/description/icon.png"
              groups="suivi_transport.group_suivi_user,suivi_transport.group_suivi_manager"
              sequence="25"/> <!-- Positioned somewhat near transport or logistique -->

    <!-- Operations Menu -->
    <menuitem id="menu_suivi_transport_operations"
              name="Opérations"
              parent="menu_suivi_transport_root"
              action="action_suivi_operation"
              sequence="10"/>

    <!-- Dépenses Menu -->
    <menuitem id="menu_suivi_transport_depenses"
              name="Dépenses RH &amp; Véhicules"
              parent="menu_suivi_transport_root"
              sequence="12"/>

    <menuitem id="menu_suivi_gazoil"
              name="Gazoil"
              parent="menu_suivi_transport_depenses"
              action="action_suivi_gazoil"
              sequence="10"/>

    <menuitem id="menu_suivi_avance"
              name="Avances"
              parent="menu_suivi_transport_depenses"
              action="action_suivi_avance"
              sequence="20"/>

    <menuitem id="menu_suivi_charge"
              name="Charges &amp; Entretien"
              parent="menu_suivi_transport_depenses"
              action="action_suivi_charge"
              sequence="30"/>

    <!-- Data Menu -->
    <menuitem id="menu_suivi_transport_data"
              name="Données"
              parent="menu_suivi_transport_root"
              sequence="20"/>

