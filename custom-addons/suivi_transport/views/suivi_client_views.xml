<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_suivi_client_tree" model="ir.ui.view">
        <field name="name">suivi.client.tree</field>
        <field name="model">suivi.client</field>
        <field name="arch" type="xml">
            <tree string="Clients Suivi">
                <field name="name"/>
                <field name="ville"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_client_form" model="ir.ui.view">
        <field name="name">suivi.client.form</field>
        <field name="model">suivi.client</field>
        <field name="arch" type="xml">
            <form string="Client Suivi">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="ville"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_suivi_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">suivi.client</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
