<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_suivi_operation_tree" model="ir.ui.view">
        <field name="name">suivi.operation.tree</field>
        <field name="model">suivi.operation</field>
        <field name="arch" type="xml">
            <tree string="Opérations Transport">
                <field name="name"/>
                <field name="date"/>
                <field name="ville"/>
                <field name="chauffeur_id"/>
                <field name="lot"/>
                <field name="montant" sum="Total Montant"/>
                <field name="credit" sum="Total Crédit"/>
                <field name="payer_id"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_operation_form" model="ir.ui.view">
        <field name="name">suivi.operation.form</field>
        <field name="model">suivi.operation</field>
        <field name="arch" type="xml">
            <form string="Fiche Opération">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chauffeur_id"/>
                            <field name="date"/>
                            <field name="ville"/>
                        </group>
                        <group>
                            <field name="montant"/>
                            <field name="credit"/>
                            <field name="payer_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Détails" name="lines_details">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="client_id" required="1"/>
                                    <field name="article_id" required="1"/>
                                    <field name="lot"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_suivi_operation_search" model="ir.ui.view">
        <field name="name">suivi.operation.search</field>
        <field name="model">suivi.operation</field>
        <field name="arch" type="xml">
            <search string="Recherche Opérations">
                <field name="name"/>
                <field name="chauffeur_id"/>
                <field name="ville"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Ville" name="group_by_ville" context="{'group_by': 'ville'}"/>
                    <filter string="Chauffeur" name="group_by_chauffeur" context="{'group_by': 'chauffeur_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_suivi_operation_pivot" model="ir.ui.view">
        <field name="name">suivi.operation.pivot</field>
        <field name="model">suivi.operation</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des Opérations" display_quantity="true">
                <field name="date" type="row" interval="month"/>
                <field name="chauffeur_id" type="row"/>
                <field name="ville" type="col"/>
                <field name="montant" type="measure"/>
                <field name="credit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_suivi_operation" model="ir.actions.act_window">
        <field name="name">Opérations</field>
        <field name="res_model">suivi.operation</field>
        <field name="view_mode">tree,form,pivot</field>
    </record>
</odoo>
