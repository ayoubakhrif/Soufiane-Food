<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ==================== SUIVI PRODUIT ==================== -->
    <record id="view_suivi_produit_tree" model="ir.ui.view">
        <field name="name">suivi.produit.tree</field>
        <field name="model">suivi.produit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="article_id"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_produit_form" model="ir.ui.view">
        <field name="name">suivi.produit.form</field>
        <field name="model">suivi.produit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du Produit"/>
                        </h1>
                    </div>
                    <group>
                        <field name="article_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_suivi_produit" model="ir.actions.act_window">
        <field name="name">Produits</field>
        <field name="res_model">suivi.produit</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ==================== SUIVI FOURNISSEUR ==================== -->
    <record id="view_suivi_fournisseur_tree" model="ir.ui.view">
        <field name="name">suivi.fournisseur.tree</field>
        <field name="model">suivi.fournisseur</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_fournisseur_form" model="ir.ui.view">
        <field name="name">suivi.fournisseur.form</field>
        <field name="model">suivi.fournisseur</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du Fournisseur"/>
                        </h1>
                    </div>
                    <group>
                        <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_suivi_fournisseur" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">suivi.fournisseur</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ==================== SUIVI STOCK ENTRY ==================== -->
    <record id="view_suivi_stock_entry_tree" model="ir.ui.view">
        <field name="name">suivi.stock.entry.tree</field>
        <field name="model">suivi.stock.entry</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'confirmed'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="qty"/>
                <field name="tonnage"/>
                <field name="ville"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'confirmed'" decoration-muted="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_stock_entry_form" model="ir.ui.view">
        <field name="name">suivi.stock.entry.form</field>
        <field name="model">suivi.stock.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_validate" string="Valider" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state not in ('confirmed', 'done')" confirm="Êtes-vous sûr de vouloir annuler cette entrée ?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="state in ('confirmed', 'done')"/>
                            <field name="date" readonly="state in ('confirmed', 'done')"/>
                            <field name="ville"/>
                        </group>
                        <group>
                            <field name="lot" readonly="state in ('confirmed', 'done')"/>
                            <field name="dum" readonly="state in ('confirmed', 'done')"/>
                            <field name="calibre" readonly="state in ('confirmed', 'done')"/>
                        </group>
                        <group>
                            <field name="qty" readonly="state in ('confirmed', 'done')"/>
                            <field name="weight" readonly="state in ('confirmed', 'done')"/>
                            <field name="tonnage"/>
                            <field name="charge_transport"/>
                        </group>
                        <group>
                            <field name="fournisseur_id" readonly="state in ('confirmed', 'done')" options="{'no_create': True}"/>
                            <field name="chauffeur_id" readonly="state in ('confirmed', 'done')" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="scan_dum" widget="url"/>
                        <button name="action_open_dum" string="Chercher Scan DUM (Drive)" type="object" class="oe_highlight"/>
                    </group>
                    <notebook>
                        <page string="Traçabilité" invisible="not move_id">
                            <group>
                                <field name="move_id"/>
                                <field name="cancel_move_id" invisible="not cancel_move_id"/>
                                <field name="validation_user_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_suivi_stock_entry" model="ir.actions.act_window">
        <field name="name">Entrées de Stock</field>
        <field name="res_model">suivi.stock.entry</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ==================== SUIVI STOCK STOCK ==================== -->
    <record id="view_suivi_stock_stock_kanban" model="ir.ui.view">
        <field name="name">suivi.stock.stock.kanban</field>
        <field name="model">suivi.stock.stock</field>
        <field name="arch" type="xml">
            <kanban create="false" delete="false" class="o_kanban_clickable">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="calibre"/>
                <field name="lot"/>
                <field name="ville"/>
                <field name="image_1920"/>
                <field name="weight"/>
                <field name="dum"/>
                <field name="scan_dum"/>
                <field name="total_weight"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record oe_kanban_global_click"
                            style="
                                border-radius:12px;
                                border:1px solid #e5e7eb;
                                box-shadow:0 4px 14px rgba(0,0,0,0.08);
                                background:#ffffff;
                                padding:12px;
                                display:flex;
                                gap:14px;
                            "
                            >

                            <!-- Image -->
                            <aside style="width:90px; height:90px; flex-shrink:0;">
                                <div class="o_kanban_image_fill w-100 h-100">
                                    <field name="image_1920"
                                        widget="image"
                                        class="w-100 h-100 rounded"
                                        options="{'img_class': 'object-fit-cover'}"/>
                                </div>
                            </aside>

                            <!-- Infos -->
                            <div class="flex-grow-1">

                                <!-- Produit -->
                                <div style="font-weight:700; font-size:15px; color:#111827; margin-bottom:6px;">
                                    <field name="product_id"/>
                                </div>

                                <!-- Badges -->
                                <div style="margin-bottom:8px;">
                                    <span style="
                                        background:#e0f2fe;
                                        color:#0369a1;
                                        padding:2px 8px;
                                        border-radius:999px;
                                        font-size:12px;
                                        margin-right:6px;">
                                        <field name="ville"/>
                                    </span>

                                    <span style="
                                        background:#f3f4f6;
                                        color:#374151;
                                        padding:2px 8px;
                                        border-radius:999px;
                                        font-size:12px;">
                                        Calibre <field name="calibre"/>
                                    </span>
                                </div>

                                <!-- Stock -->
                                <div style="font-size:13px; color:#374151; line-height:1.6;">
                                    <div>
                                        📦 <b>Quantité :</b>
                                        <span style="color:#059669;">
                                            <field name="quantity"/>
                                        </span>
                                    </div>
                                    <div>
                                        ⚖️ <b>Poids :</b> <field name="weight"/> Kg (Tonnage: <field name="total_weight"/> Kg)
                                    </div>
                                </div>

                                <hr style="margin:8px 0; border:none; border-top:1px dashed #e5e7eb;"/>

                                <!-- Détails -->
                                <div style="font-size:13px; color:#374151; line-height:1.6;">
                                    <div>
                                        🏷️ <b>Lot :</b> <field name="lot"/> | <b>DUM :</b> <field name="dum"/>
                                        <!-- DUM Indicator -->
                                        <t t-if="record.dum.raw_value">
                                            <t t-if="record.scan_dum.raw_value">
                                                <span title="DUM Disponible" style="display:inline-block; width:10px; height:10px; background-color:#22c55e; border-radius:50%; margin-left:4px;"></span>
                                            </t>
                                            <t t-else="">
                                                <span title="DUM Manquant (Drive)" style="display:inline-block; width:10px; height:10px; background-color:#ef4444; border-radius:50%; margin-left:4px;"></span>
                                            </t>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_suivi_stock_stock_tree" model="ir.ui.view">
        <field name="name">suivi.stock.stock.tree</field>
        <field name="model">suivi.stock.stock</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false" decoration-muted="quantity == 0">
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <field name="ville"/>
                <field name="quantity"/>
                <field name="weight"/>
                <field name="calibre"/>
                <field name="total_weight"/>
                <field name="write_date"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_stock_stock_search" model="ir.ui.view">
        <field name="name">suivi.stock.stock.search</field>
        <field name="model">suivi.stock.stock</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="lot"/>
                <field name="dum"/>
                <filter string="En Stock (Qte > 0)" name="in_stock" domain="[('quantity', '>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Produit" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Lot" name="group_lot" context="{'group_by':'lot'}"/>
                    <filter string="DUM" name="group_dum" context="{'group_by':'dum'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_suivi_stock_stock" model="ir.actions.act_window">
        <field name="name">État du Stock</field>
        <field name="res_model">suivi.stock.stock</field>
        <field name="view_mode">kanban,tree</field>
        <field name="context">{'search_default_in_stock': 1}</field>
    </record>

    <!-- ==================== SUIVI STOCK MOVE ==================== -->
    <record id="view_suivi_stock_move_tree" model="ir.ui.view">
        <field name="name">suivi.stock.move.tree</field>
        <field name="model">suivi.stock.move</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" decoration-info="move_type == 'entry'" decoration-danger="move_type == 'exit'" decoration-warning="move_type in ('cancel_entry', 'cancel_exit')">
                <field name="date"/>
                <field name="reference"/>
                <field name="product_id"/>
                <field name="move_type"/>
                <field name="qty"/>
                <field name="tonnage"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="action_suivi_stock_move" model="ir.actions.act_window">
        <field name="name">Mouvements de Stock</field>
        <field name="res_model">suivi.stock.move</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
