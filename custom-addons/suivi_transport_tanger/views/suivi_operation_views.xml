<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_suivi_tanger_operation_tree" model="ir.ui.view">
        <field name="name">suivi.transport.tanger.operation.tree</field>
        <field name="model">suivi.transport.tanger.operation</field>
        <field name="arch" type="xml">
            <tree string="Opérations Transport">
                <field name="name"/>
                <field name="date"/>
                <field name="ville"/>
                <field name="chauffeur_id"/>
                <field name="montant" sum="Total Montant" invisible="ville == 'casa'"/>
                <field name="credit" sum="Total Crédit" invisible="ville == 'casa'"/>
                <field name="casa_payer_id"/>
                <field name="state" widget="badge" decoration-info="state == 'initial'" decoration-warning="state == 'credit'" decoration-success="state == 'paid'" decoration-primary="state == 'validated'"/>
            </tree>
        </field>
    </record>

    <record id="view_suivi_tanger_operation_form" model="ir.ui.view">
        <field name="name">suivi.transport.tanger.operation.form</field>
        <field name="model">suivi.transport.tanger.operation</field>
        <field name="arch" type="xml">
            <form string="Fiche Opération">
                <header>
                    <button name="action_credit" string="Mettre en Crédit" type="object" class="oe_highlight" groups="suivi_transport_tanger.group_suivi_tanger_user" invisible="state != 'initial'"/>
                    <button name="action_pay" string="Confirmer Paiement" type="object" class="oe_highlight" groups="suivi_transport_tanger.group_suivi_tanger_user" invisible="state not in ('initial', 'credit')"/>
                    <button name="action_validate" string="Valider" type="object" class="oe_highlight" groups="casa_stock.group_manager" invisible="state != 'paid'"/>
                    <button name="action_toggle_paid_by_caisse" string="Marquer Payé par Caisse" type="object" groups="casa_stock.group_manager" invisible="paid_by_caisse == True or state == 'validated'"/>
                    <button name="action_toggle_paid_by_caisse" string="Démarquer Payé par Caisse" type="object" groups="casa_stock.group_manager" invisible="paid_by_caisse == False or state == 'validated'"/>
                    <button name="action_set_initial" string="Remettre en Initial" type="object" groups="suivi_transport_tanger.group_suivi_tanger_manager" invisible="state == 'initial'"/>
                    <button name="action_cancel" string="Annuler" type="object" groups="suivi_transport_tanger.group_suivi_tanger_manager" invisible="state in ('cancelled', 'validated')"/>
                    <field name="state" widget="statusbar" statusbar_visible="initial,credit,paid,validated,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="chauffeur_id" readonly="state == 'validated'"/>
                            <field name="date" readonly="state == 'validated'"/>
                            <field name="ville" readonly="state == 'validated'"/>
                        </group>
                        <group>
                            <field name="montant" invisible="ville == 'casa'" required="ville != 'casa'" readonly="state == 'validated'"/>
                            <field name="credit" invisible="ville == 'casa'" required="ville != 'casa'" readonly="state == 'validated'"/>
                            <field name="available_client_ids" invisible="1"/>
                            <field name="paid_by_caisse" readonly="state == 'validated'"/>
                            <field name="paid_by_tresorerie" readonly="state == 'validated'"/>
                            <field name="casa_payer_id" options="{'no_create': True}" readonly="state == 'validated'" invisible="paid_by_caisse == True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Détails" name="lines_details">
                            <field name="line_ids" readonly="state == 'validated'">
                                <tree editable="bottom">
                                    <field name="casa_client_id" options="{'no_create': True, 'no_create_edit': True}" required="1"/>
                                    <field name="use_client2" column_invisible="True"/>
                                    <field name="client2" invisible="not use_client2" required="use_client2"/>
                                    <field name="article_id" required="1"/>
                                    <field name="lot"/>
                                    <field name="exit_id" readonly="1" force_save="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_suivi_tanger_operation_search" model="ir.ui.view">
        <field name="name">suivi.transport.tanger.operation.search</field>
        <field name="model">suivi.transport.tanger.operation</field>
        <field name="arch" type="xml">
            <search string="Recherche Opérations">
                <field name="name"/>
                <field name="chauffeur_id"/>
                <field name="ville"/>
                <group expand="0" string="Regrouper par">
                    <filter string="État" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Ville" name="group_by_ville" context="{'group_by': 'ville'}"/>
                    <filter string="Chauffeur" name="group_by_chauffeur" context="{'group_by': 'chauffeur_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_suivi_tanger_operation_pivot" model="ir.ui.view">
        <field name="name">suivi.transport.tanger.operation.pivot</field>
        <field name="model">suivi.transport.tanger.operation</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des Opérations" display_quantity="true">
                <field name="date" type="row" interval="month"/>
                <field name="chauffeur_id" type="row"/>
                <field name="ville" type="col"/>
                <field name="montant" type="measure"/>
                <field name="credit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_suivi_tanger_operation" model="ir.actions.act_window">
        <field name="name">Opérations</field>
        <field name="res_model">suivi.transport.tanger.operation</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>
</odoo>
