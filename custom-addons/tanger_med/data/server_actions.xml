<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_generate_missing_sutra" model="ir.actions.server">
            <field name="name">Générer Dossiers SUTRA manquants</field>
            <field name="model_id" ref="logistique.model_logistique_entry"/>
            <field name="binding_model_id" ref="logistique.model_logistique_entry"/>
            <field name="state">code</field>
            <field name="code">
for record in records:
    existing = env['sutra.dossier'].search([('logistics_id', '=', record.id)])
    if not existing:
        env['sutra.dossier'].create({'logistics_id': record.id})
            </field>
        </record>
    </data>
</odoo>
