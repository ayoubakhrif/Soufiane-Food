<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_tanger_med_category" model="ir.module.category">
        <field name="name">Tanger Med</field>
        <field name="description">Gestion des accès pour le module Tanger Med</field>
        <field name="sequence">15</field>
    </record>

    <record id="group_tanger_med_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_tanger_med_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_tanger_med_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_tanger_med_category"/>
        <field name="implied_ids" eval="[(4, ref('group_tanger_med_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
