<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_finance2_cheque_sutra_inherit" model="ir.ui.view">
            <field name="name">finance2.cheque.sutra.inherit</field>
            <field name="model">finance2.cheque</field>
            <field name="inherit_id" ref="finance_2.view_finance2_cheque_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <field name="is_sutra_benif" invisible="1"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Factures SUTRA" invisible="not is_sutra_benif">
                        <field name="sutra_facture_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="sutra_id"/>
                                <field name="date"/>
                                <field name="amount" sum="Total"/>
                                <field name="state" widget="badge" decoration-success="state == 'paye'" decoration-warning="state == 'encours'" decoration-danger="state == 'non_paye'"/>
                                <field name="pdf_filename" invisible="1"/>
                                <field name="pdf_file" filename="pdf_filename" widget="binary"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
