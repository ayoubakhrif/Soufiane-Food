<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- Tanger Med: Dedicated Tree View              -->
    <!-- ============================================ -->
    <record id="view_tanger_med_entry_tree" model="ir.ui.view">
        <field name="name">tanger.med.entry.tree</field>
        <field name="model">logistique.entry</field>
        <field name="arch" type="xml">
            <tree string="Tanger Med" create="false" delete="false" default_order="bad_date desc">
                <field name="bl_number"/>
                <field name="tanger_med_state" widget="badge" decoration-info="tanger_med_state in ('port', 'attente_ml')" decoration-warning="tanger_med_state in ('analyse', 'visite', 'en_cours_chargement', 'sortie_plein', 'rentree_vide')" decoration-success="tanger_med_state == 'arrive_depot'"/>
                <field name="week"/>
                <field name="ste_id"/>
                <field name="supplier_id"/>
                <field name="article_id"/>
                <field name="container_count" optional="show"/>
                <field name="container_names" string="Conteneurs" optional="show"/>
                <field name="exit_date"/>
                <field name="entry_date"/>
                <field name="bad_date"/>
                <field name="eta" optional="show"/>
                <field name="invoice_number" optional="show"/>
                <field name="destination_id" optional="show"/>
                <field name="tanger_med_lot" optional="show"/>
                <field name="tanger_med_dum" optional="show"/>
                <field name="sur_mag_amount" sum="SUR+MAG"/>
                <field name="sur_mag_date"/>
                <field name="sur_mag_user" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Tanger Med: Dedicated Form View              -->
    <!-- ============================================ -->
    <record id="view_tanger_med_entry_form" model="ir.ui.view">
        <field name="name">tanger.med.entry.form</field>
        <field name="model">logistique.entry</field>
        <field name="arch" type="xml">
            <form string="Dossier Tanger Med" create="false" delete="false">
                <header>
                    <button name="action_tanger_med_attente_ml" string="Attente Main Levée" type="object" class="oe_highlight" invisible="tanger_med_state != 'port'"/>
                    <button name="action_tanger_med_analyse" string="Analyse" type="object" class="oe_highlight" invisible="tanger_med_state not in ('port', 'attente_ml', 'visite')"/>
                    <button name="action_tanger_med_visite" string="Visite" type="object" class="oe_highlight" invisible="tanger_med_state not in ('port', 'attente_ml', 'analyse')"/>
                    <button name="action_tanger_med_en_cours_chargement" string="En cours de chargement" type="object" class="oe_highlight" invisible="tanger_med_state not in ('port', 'attente_ml', 'analyse', 'visite')"/>
                    <button name="action_tanger_med_sortie_plein" string="Sortie Plein" type="object" class="oe_highlight" invisible="tanger_med_state not in ('port', 'attente_ml', 'analyse', 'visite', 'en_cours_chargement')"/>
                    <button name="action_tanger_med_rentree_vide" string="Rentrée Vide" type="object" class="oe_highlight" invisible="tanger_med_state != 'sortie_plein'"/>
                    <button name="action_tanger_med_arrive_depot" string="Arrivé au Dépôt" type="object" class="oe_highlight" invisible="tanger_med_state != 'rentree_vide'"/>
                    <button name="action_tanger_med_reset" string="Remettre Au Port" type="object" invisible="tanger_med_state == 'port'" groups="tanger_med.group_tanger_med_manager"/>
                    <field name="tanger_med_state" widget="statusbar" statusbar_visible="port,attente_ml,analyse,visite,en_cours_chargement,sortie_plein,rentree_vide,arrive_depot"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="bl_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informations Dossier">
                            <field name="dossier_id" readonly="1"/>
                            <field name="ste_id" readonly="1"/>
                            <field name="supplier_id" readonly="1"/>
                            <field name="article_id" readonly="1"/>
                            <field name="shipping_id" readonly="1"/>
                            <field name="free_time" readonly="1"/>
                            <field name="destination_id" />
                            <field name="details" readonly="1"/>
                            <field name="invoice_number" readonly="1"/>
                            <field name="container_count" readonly="1"/>
                            <field name="container_type"/>
                            <field name="container_size"/>
                            <field name="container_names" readonly="1"/>
                        </group>
                        <group string="Statut">
                            <field name="port_status" readonly="1" widget="badge" decoration-success="port_status == 'exited'"/>
                            <field name="status" readonly="1" widget="badge"/>
                            <field name="incoterm" readonly="1"/>
                        </group>
                    </group>
                    <group string="Workflow Tanger Med">
                        <group string="Contrôles Port">
                            <field name="is_analyse"/>
                            <field name="date_analyse" invisible="not is_analyse"/>
                            <field name="is_visite"/>
                            <field name="date_visite" invisible="not is_visite"/>
                        </group>
                        <group string="Étapes Logistiques">
                            <field name="date_sortie_port"/>
                            <field name="date_arrive_stock"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tanger Med" name="tanger_med">
                            <group>
                                <group string="Dates Opérationnelles">
                                    <field name="exit_date"/>
                                    <field name="entry_date"/>
                                    <field name="bad_date" readonly="1"/>
                                    <field name="eta" readonly="1"/>
                                    <field name="tanger_med_lot"/>
                                    <field name="tanger_med_dum"/>
                                    <field name="week"/>
                                </group>
                                <group string="SUR+MAG">
                                    <field name="calculated_surestarie_ht" readonly="1"/>
                                    <field name="calculated_magasinage_ht" readonly="1"/>
                                    <field name="sur_mag_amount"/>
                                    <field name="sur_mag_date" readonly="1"/>
                                    <field name="sur_mag_user" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <separator string="Historique"/>
                    <div class="oe_chatter" groups="tanger_med.group_tanger_med_manager">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- Tanger Med: Search View                      -->
    <!-- ============================================ -->
    <record id="view_tanger_med_entry_search" model="ir.ui.view">
        <field name="name">tanger.med.entry.search</field>
        <field name="model">logistique.entry</field>
        <field name="arch" type="xml">
            <search string="Recherche Tanger Med">
                <field name="bl_number"/>
                <field name="week"/>
                <field name="ste_id"/>
                <field name="supplier_id"/>
                <field name="article_id"/>
                <field name="container_names" string="Conteneur"/>
                <group string="Regrouper par">
                    <filter name="group_tanger_med_state" string="Statut Tanger Med" context="{'group_by': 'tanger_med_state'}"/>
                    <filter name="group_week" string="Semaine" context="{'group_by': 'week'}"/>
                    <filter name="group_ste" string="Société" context="{'group_by': 'ste_id'}"/>
                    <filter name="group_supplier" string="Supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter name="group_article" string="Article" context="{'group_by': 'article_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
