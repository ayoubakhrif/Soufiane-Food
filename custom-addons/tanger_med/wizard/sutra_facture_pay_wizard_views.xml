<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sutra_facture_pay_wizard_form" model="ir.ui.view">
            <field name="name">sutra.facture.pay.wizard.form</field>
            <field name="model">sutra.facture.pay.wizard</field>
            <field name="arch" type="xml">
                <form string="Generer Cheque de Paiement">
                    <group>
                        <group>
                            <field name="cheque_number"/>
                            <field name="amount_total"/>
                            <field name="date_emission"/>
                        </group>
                        <group>
                            <field name="ste_id"/>
                            <field name="benif_id"/>
                            <field name="journal"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Factures a regler">
                            <field name="facture_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="sutra_id"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_generate_cheque" string="Generer et Lier le Cheque" type="object" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action window for wizard (can be called from tree view) -->
        <record id="action_sutra_facture_pay_wizard" model="ir.actions.act_window">
            <field name="name">Payer Factures</field>
            <field name="res_model">sutra.facture.pay.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_sutra_facture"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
