<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sutra_import_wizard_form" model="ir.ui.view">
            <field name="name">sutra.import.wizard.form</field>
            <field name="model">sutra.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Importer Factures SUTRA">
                    <group>
                        <p class="text-muted" colspan="2">
                            Le fichier Excel (.xlsx) doit contenir les colonnes suivantes dans cet ordre précis :<br/>
                            <b>1. DUM</b> | <b>2. Numéro Facture</b> | <b>3. Date (Optionnel)</b> | <b>4. Montant TTC</b>
                        </p>
                        <field name="filename" invisible="1"/>
                        <field name="file" filename="filename" widget="binary"/>
                    </group>
                    <footer>
                        <button name="action_import" string="Importer" type="object" class="btn-primary"/>
                        <button string="Annuler" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sutra_import_wizard" model="ir.actions.act_window">
            <field name="name">Importer Factures</field>
            <field name="res_model">sutra.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_sutra_import" name="Importer Factures Excel" parent="tanger_med.menu_sutra_main" action="action_sutra_import_wizard" sequence="30"/>
    </data>
</odoo>
