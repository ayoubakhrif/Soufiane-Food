<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="action_report_trip_remorque_recap" model="ir.actions.report">
        <field name="name">Récapitulatif des Voyages Remorque</field>
        <field name="model">transport.trip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">transport_management.report_trip_remorque_recap_template</field>
        <field name="report_file">transport_management.report_trip_remorque_recap_template</field>
        <field name="binding_model_id" ref="model_transport_trip_remorque"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template -->
    <template id="report_trip_remorque_recap_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <style>
                        .report-header { margin-bottom: 25px; }
                        .header-row { display: flex; align-items: stretch; margin-bottom: 15px; }
                        .date-box { background-color: #E6F4EA; border: 1px solid #137333; padding: 12px; font-size: 18px; font-weight: bold; width: 25%; text-align: center; color: #137333; border-radius: 4px; margin-right: 15px; }
                        .title-box { background-color: #137333; border: 1px solid #137333; padding: 12px; font-size: 22px; font-weight: bold; color: white; flex-grow: 1; text-align: center; border-radius: 4px; text-transform: uppercase; letter-spacing: 1px; }
                        
                        /* Driver block */
                        .driver-section { margin-top: 30px; border: 2px solid #137333; border-radius: 4px; overflow: hidden; page-break-inside: avoid; }
                        .driver-header { background-color: #137333; color: white; padding: 10px; display: flex; justify-content: space-between; align-items: center; }
                        .driver-title { font-size: 18px; font-weight: bold; text-transform: uppercase; }
                        .driver-stats { font-size: 14px; font-weight: bold; }
                        
                        .day-header { background: none; color: #137333; padding: 8px 5px 4px 5px; font-size: 14px; font-weight: bold; margin-top: 15px; border-bottom: 2px solid #E6F4EA; margin-bottom: 5px; }
                        
                        /* Base Table Styles */
                        .data-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
                        .data-table th { padding: 6px; text-align: center; font-size: 11px; font-weight: bold; color: #137333; background-color: #E6F4EA; text-transform: uppercase; border: 1px solid #A8DAB5; }
                        .data-table td { padding: 5px; text-align: center; font-size: 11px; color: #333; border: 1px solid #E6F4EA; }
                        .data-table tr:nth-child(even) { background-color: #F9FAFB; }
                        .amount-cell { font-weight: bold; color: #137333; text-align: right; white-space: nowrap; }
                        
                        /* Summary Stats Table */
                        .summary-table { width: 100%; border-collapse: collapse; margin-top: 20px; margin-bottom: 20px; border-radius: 4px; overflow: hidden; page-break-inside: avoid; }
                        .summary-table th { background-color: #E6F4EA; border: 1px solid #A8DAB5; padding: 10px; text-align: center; font-size: 13px; font-weight: bold; color: #137333; text-transform: uppercase; }
                        .summary-table td { border: 1px solid #A8DAB5; padding: 10px; text-align: center; font-size: 13px; font-weight: bold; }
                        .state-global { background-color: #F1F3F4; color: #3C4043; }
                        
                        .footer { margin-top: 35px; font-style: italic; font-size: 10px; border-top: 1px solid #E6F4EA; padding-top: 10px; color: #666; display: flex; justify-content: space-between; }
                    </style>

                    <!-- Header -->
                    <div class="report-header">
                        <div class="header-row">
                            <div class="date-box">
                                <t t-esc="report_date"/>
                            </div>
                            <div class="title-box">
                                Récapitulatif des Voyages Remorque Sélectionnés
                            </div>
                        </div>
                    </div>

                    <!-- Drivers Sections -->
                    <t t-foreach="drivers_list" t-as="d_data">
                        <div class="driver-section">
                            <div class="driver-header">
                                <div class="driver-title"><t t-esc="d_data['driver'].name if d_data['driver'] else 'Sans Chauffeur'"/></div>
                                <div class="driver-stats">
                                    <t t-esc="d_data['count']"/> Voyage(s) | 
                                    Charges: <t t-esc="'{:,.2f}'.format(d_data['charges']).replace(',', ' ')"/> DH | 
                                    Bénéfice: <t t-esc="'{:,.2f}'.format(d_data['profit']).replace(',', ' ')"/> DH
                                </div>
                            </div>
                            
                            <div style="padding: 5px;">
                                <t t-foreach="d_data['weeks_list']" t-as="day_data">
                                    <div class="day-header">
                                        <t t-esc="day_data['label']"/> 
                                        - <t t-esc="day_data['count']"/> voyage(s) (Bénéfice: <t t-esc="'{:,.2f}'.format(day_data['profit']).replace(',', ' ')"/> DH)
                                    </div>
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 9%;">Date</th>
                                                <th style="width: 15%;">Client</th>
                                                <th style="width: 10%;">Matricule</th>
                                                <th style="width: 10%;">Allée</th>
                                                <th style="width: 9%;">Gazoil</th>
                                                <th style="width: 9%;">Dép.</th>
                                                <th style="width: 9%;">AdBlue</th>
                                                <th style="width: 9%;">Mixe</th>
                                                <th style="width: 10%;">Charges</th>
                                                <th style="width: 10%;">Bénéfice</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="day_data['trips']" t-as="trip">
                                                <tr>
                                                    <td><t t-esc="trip.date.strftime('%d/%m') if trip.date else ''"/></td>
                                                    <td><t t-esc="trip.client_id.name"/></td>
                                                    <td><t t-esc="trip.vehicle_id.matricule if trip.vehicle_id else ''"/></td>
                                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(trip.going_price).replace(',', ' ')"/></td>
                                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(trip.charge_fuel).replace(',', ' ')"/></td>
                                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(trip.charge_driver).replace(',', ' ')"/></td>
                                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(trip.charge_adblue).replace(',', ' ')"/></td>
                                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(trip.charge_mixed).replace(',', ' ')"/></td>
                                                    <td class="amount-cell" style="color: #C5221F;"><t t-esc="'{:,.2f}'.format(trip.total_amount).replace(',', ' ')"/></td>
                                                    <td class="amount-cell" style="color: #137333;"><t t-esc="'{:,.2f}'.format(trip.profit).replace(',', ' ')"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </div>
                    </t>
                    
                    <!-- Global Recap by Day -->
                    <div style="page-break-inside: avoid; margin-top: 40px;">
                        <div class="title-box" style="font-size: 16px; padding: 8px;">Récapitulatif par Semaine (Tous les chauffeurs)</div>
                        <table class="summary-table">
                            <thead>
                                <tr>
                                    <th style="width: 16%;">Semaine</th>
                                    <th style="width: 12%;">Nbr. Voyages Remorque</th>
                                    <th style="width: 10%;">Gazoil</th>
                                    <th style="width: 10%;">Dép.</th>
                                    <th style="width: 10%;">AdBlue</th>
                                    <th style="width: 10%;">Mixe</th>
                                    <th style="width: 16%;">Tot. Charges</th>
                                    <th style="width: 16%;">Bénéfice Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="global_days_list" t-as="g_day">
                                    <tr>
                                        <td><t t-esc="g_day['label']"/></td>
                                        <td><t t-esc="g_day['count']"/></td>
                                        <td class="amount-cell"><t t-esc="'{:,.2f}'.format(g_day['fuel']).replace(',', ' ')"/></td>
                                        <td class="amount-cell"><t t-esc="'{:,.2f}'.format(g_day['driver']).replace(',', ' ')"/></td>
                                        <td class="amount-cell"><t t-esc="'{:,.2f}'.format(g_day['adblue']).replace(',', ' ')"/></td>
                                        <td class="amount-cell"><t t-esc="'{:,.2f}'.format(g_day['mixed']).replace(',', ' ')"/></td>
                                        <td class="amount-cell" style="color: #C5221F;"><t t-esc="'{:,.2f}'.format(g_day['charges']).replace(',', ' ')"/> DH</td>
                                        <td class="amount-cell" style="color: #137333;"><t t-esc="'{:,.2f}'.format(g_day['profit']).replace(',', ' ')"/> DH</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Global Recap Total -->
                    <div style="page-break-inside: avoid; margin-top: 30px;">
                        <div class="title-box" style="font-size: 16px; padding: 8px;">Récapitulatif Global</div>
                        <table class="summary-table">
                            <thead>
                                <tr>
                                    <th style="width: 12%;">Total Voyages Remorque</th>
                                    <th style="width: 12%;">Tot. Allées</th>
                                    <th style="width: 12%;">Tot. Retours</th>
                                    <th style="width: 10%;">Tot. Gazoil</th>
                                    <th style="width: 10%;">Tot. Dép.</th>
                                    <th style="width: 10%;">Tot. AdBlue</th>
                                    <th style="width: 10%;">Tot. Mixe</th>
                                    <th style="width: 12%;">Tot. Charges</th>
                                    <th style="width: 12%;">Bénéf. Global</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="state-global" style="font-size: 15px;">
                                    <td><t t-esc="global_count"/></td>
                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(global_going).replace(',', ' ')"/> DH</td>
                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(global_returning).replace(',', ' ')"/> DH</td>
                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(global_fuel).replace(',', ' ')"/> DH</td>
                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(global_driver).replace(',', ' ')"/> DH</td>
                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(global_adblue).replace(',', ' ')"/> DH</td>
                                    <td class="amount-cell"><t t-esc="'{:,.2f}'.format(global_mixed).replace(',', ' ')"/> DH</td>
                                    <td class="amount-cell" style="color: #C5221F;"><t t-esc="'{:,.2f}'.format(global_charges).replace(',', ' ')"/> DH</td>
                                    <td class="amount-cell" style="color: #137333; font-size: 16px;"><t t-esc="'{:,.2f}'.format(global_profit).replace(',', ' ')"/> DH</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer -->
                    <div class="footer">
                        <span>Généré par Gestia ERP - Transport</span>
                        <span>Rapport Récapitulatif</span>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
