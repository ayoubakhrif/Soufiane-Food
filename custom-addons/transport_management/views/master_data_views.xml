<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Driver Views -->
    <record id="view_transport_driver_tree" model="ir.ui.view">
        <field name="name">transport.driver.tree</field>
        <field name="model">transport.driver</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="vehicle_type"/>
                <field name="employee_id"/>
                <field name="remorque"/>
                <field name="total_trip_count"/>
            </tree>
        </field>
    </record>

    <record id="view_transport_driver_form" model="ir.ui.view">
        <field name="name">transport.driver.form</field>
        <field name="model">transport.driver</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vehicle_type"/>
                            <field name="employee_id"/>
                            <field name="remorque"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Alias">
                            <field name="alias_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Voyages">
                            <field name="trip_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="trip_type"/>
                                    <field name="total_price" sum="Total"/>
                                    <field name="profit" sum="Bénéfice"/>
                                    <field name="is_paid"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Voyages Remorque" invisible="not remorque">
                            <field name="remorque_trip_ids">
                                <tree>
                                    <field name="date"/>
                                    <field name="client_id"/>
                                    <field name="destination"/>
                                    <field name="total_price" sum="Total"/>
                                    <field name="profit" sum="Bénéfice"/>
                                    <field name="is_paid"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Client Views -->
    <record id="view_transport_client_tree" model="ir.ui.view">
        <field name="name">transport.client.tree</field>
        <field name="model">transport.client</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Driver Action -->
    <record id="action_transport_driver" model="ir.actions.act_window">
        <field name="name">Chauffeurs</field>
        <field name="res_model">transport.driver</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Client Action -->
    <record id="action_transport_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">transport.client</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
