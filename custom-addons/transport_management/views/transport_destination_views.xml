<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_transport_destination_tree" model="ir.ui.view">
        <field name="name">transport.destination.tree</field>
        <field name="model">transport.destination</field>
        <field name="arch" type="xml">
            <tree string="Destinations">
                <field name="name"/>
                <field name="mandatory_return" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_transport_destination_form" model="ir.ui.view">
        <field name="name">transport.destination.form</field>
        <field name="model">transport.destination</field>
        <field name="arch" type="xml">
            <form string="Destination">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la destination"/>
                        </h1>
                    </div>
                    <group>
                        <field name="mandatory_return" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_transport_destination" model="ir.actions.act_window">
        <field name="name">Destinations</field>
        <field name="res_model">transport.destination</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_transport_destination"
              name="Destinations"
              parent="transport_management.menu_transport_data"
              action="action_transport_destination"
              sequence="30"
              groups="group_transport_viewer,group_transport_user,group_transport_manager"/>
</odoo>
