<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_transport_ste_tree" model="ir.ui.view">
        <field name="name">transport.ste.tree</field>
        <field name="model">transport.ste</field>
        <field name="arch" type="xml">
            <tree string="Sociétés de Transport" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_transport_ste" model="ir.actions.act_window">
        <field name="name">Sociétés</field>
        <field name="res_model">transport.ste</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <menuitem id="menu_transport_ste"
            name="Sociétés"
            parent="menu_transport_data"
            action="action_transport_ste"
            sequence="30"/>
</odoo>
