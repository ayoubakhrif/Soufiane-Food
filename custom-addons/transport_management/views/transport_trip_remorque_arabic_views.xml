<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================== -->
    <!-- TRANSPORT TRIP REMORQUE ARABIC VIEWS                    -->
    <!-- ======================================================== -->

    <!-- Form View -->
    <record id="view_transport_trip_remorque_arab_form" model="ir.ui.view">
        <field name="name">transport.trip.remorque.arab.form</field>
        <field name="model">transport.trip.remorque.arab</field>
        <field name="arch" type="xml">
            <form string="رحلة نقل مقطورة">
                <sheet>
                    <!-- ================= TITLE ================= -->
                    <div class="oe_title">
                        <h1>
                            <field name="date" class="oe_inline"/>
                        </h1>
                    </div>

                    <!-- ================= GENERAL INFO ================= -->
                    <group string="معلومات الرحلة">
                        <group>
                            <field name="driver_remorque_id"/>
                            <field name="going_price"/>
                        </group>
                        <group>
                            <field name="destination"/>
                        </group>
                    </group>

                    <!-- ================= CHARGES ================= -->
                    <group string="المصاريف">
                        <group>
                            <field name="charge_fuel"/>
                            <field name="charge_driver"/>
                            <field name="charge_adblue"/>
                            <field name="charge_mixed"/>
                            <field name="note" invisible="charge_mixed == 0" required="charge_mixed &gt; 0"/>
                        </group>
                    </group>

                    <!-- ================= TOTAL ================= -->
                    <group string="الملخص">
                        <group>
                            <field name="total_amount"
                                readonly="1"
                                class="oe_inline"
                                widget="monetary"/>
                            <field name="profit"/>
                        </group>
                    </group>

                    <!-- ================= COMMENTS ================= -->
                    <group string="تعليق">
                        <field name="note" placeholder="تحديد تفاصيل المصاريف المتنوعة"/>
                    </group>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>


    <!-- Tree View -->
    <record id="view_transport_trip_remorque_arab_tree" model="ir.ui.view">
        <field name="name">transport.trip.remorque.arab.tree</field>
        <field name="model">transport.trip.remorque.arab</field>
        <field name="arch" type="xml">
            <tree string="رحلات النقل مقطورة">
                <field name="date"/>
                <field name="driver_remorque_id"/>
                <field name="profit" sum="إجمالي الربح"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_transport_trip_remorque_arab_search" model="ir.ui.view">
        <field name="name">transport.trip.remorque.arab.search</field>
        <field name="model">transport.trip.remorque.arab</field>
        <field name="arch" type="xml">
            <search string="البحث في رحلات النقل مقطورة">
                <field name="driver_remorque_id"/>
                <field name="destination"/>
                <field name="date"/>
                
                <separator/>
                <filter string="اليوم" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="هذا الشهر" name="this_month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>

                <group expand="0" string="تجميع حسب">
                    <filter string="السائق" name="group_driver" domain="[]" context="{'group_by': 'driver_remorque_id'}"/>
                    <filter string="الوجهة" name="group_dest" domain="[]" context="{'group_by': 'destination'}"/>
                    <filter string="التاريخ" name="group_date" domain="[]" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_transport_trip_remorque_arab_pivot" model="ir.ui.view">
        <field name="name">transport.trip.remorque.arab.pivot</field>
        <field name="model">transport.trip.remorque.arab</field>
        <field name="arch" type="xml">
            <pivot string="تحليل النقل مقطورة">
                <field name="date" type="row" interval="day"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_transport_trip_remorque_arab_graph" model="ir.ui.view">
        <field name="name">transport.trip.remorque.arab.graph</field>
        <field name="model">transport.trip.remorque.arab</field>
        <field name="arch" type="xml">
            <graph string="تحليل النقل مقطورة" type="bar">
                <field name="date" type="row" interval="day"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_transport_trip_remorque_arab" model="ir.actions.act_window">
        <field name="name">رحلات النقل مقطورة (عربي)</field>
        <field name="res_model">transport.trip.remorque.arab</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="context">{'search_default_group_driver': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أنشئ رحلة نقل مقطورة جديدة!
            </p>
        </field>
    </record>


    <!-- ======================================================== -->
    <!-- DRIVER BALANCE RECONCILIATION ARABIC VIEWS              -->
    <!-- ======================================================== -->

    <!-- Tree View -->
    <record id="view_transport_driver_balance_arab_tree" model="ir.ui.view">
        <field name="name">transport.driver.balance.arab.tree</field>
        <field name="model">transport.driver.balance.arab</field>
        <field name="arch" type="xml">
            <tree string="تسوية حسابات السائقين (مقطورة)" create="true" delete="true">
                <field name="driver_id"/>
                <field name="total_profit" sum="إجمالي الأرباح"/>
                <field name="total_paid" sum="إجمالي المبالغ المستلمة"/>
                <field name="total_unpaid" sum="إجمالي المبالغ غير المدفوعة"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_transport_driver_balance_arab_form" model="ir.ui.view">
        <field name="name">transport.driver.balance.arab.form</field>
        <field name="model">transport.driver.balance.arab</field>
        <field name="arch" type="xml">
            <form string="تسوية حساب السائق">
                <sheet>
                    <div class="oe_title">
                        <label for="driver_id" class="oe_edit_only" string="السائق / الشوفير"/>
                        <h1>
                            <field name="driver_id" placeholder="اختر الشوفير / السائق"/>
                        </h1>
                    </div>

                    <!-- Financial Balance Dashboard -->
                    <group string="ملخص الحساب المالي">
                        <group>
                            <field name="total_profit" readonly="1" class="oe_inline" style="font-size: 1.5em; font-weight: bold; color: #2C3E50;"/>
                            <field name="total_paid" readonly="1" class="oe_inline" style="font-size: 1.5em; font-weight: bold; color: #27AE60;"/>
                            <field name="total_unpaid" readonly="1" class="oe_inline" style="font-size: 1.5em; font-weight: bold; color: #C0392B;"/>
                        </group>
                    </group>

                    <!-- Payment lines (Ledger) -->
                    <notebook>
                        <page string="سجل المبالغ المستلمة (الدفعات)">
                            <field name="payment_line_ids" context="{'default_balance_id': active_id}">
                                <tree string="الدفعات" editable="bottom">
                                    <field name="date"/>
                                    <field name="amount" sum="إجمالي المبالغ المستلمة"/>
                                    <field name="note" placeholder="أدخل أي ملاحظة هنا"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_transport_driver_balance_arab_search" model="ir.ui.view">
        <field name="name">transport.driver.balance.arab.search</field>
        <field name="model">transport.driver.balance.arab</field>
        <field name="arch" type="xml">
            <search string="البحث في حسابات السائقين">
                <field name="driver_id"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="السائق" name="group_driver" domain="[]" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_transport_driver_balance_arab" model="ir.actions.act_window">
        <field name="name">تسوية حسابات السائقين (مقطورة)</field>
        <field name="res_model">transport.driver.balance.arab</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أنشئ تسوية حساب جديدة لسائق مقطورة!
            </p>
        </field>
    </record>


    <!-- ======================================================== -->
    <!-- MENUITEMS CONFIGURATION                                 -->
    <!-- ======================================================== -->

</odoo>
