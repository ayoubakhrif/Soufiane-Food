<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_transport_trip_remorque_form" model="ir.ui.view">
        <field name="name">transport.trip.remorque.form</field>
        <field name="model">transport.trip.remorque</field>
        <field name="arch" type="xml">
            <form string="Transport Trip Remorque">

                <!-- ================= HEADER ================= -->
                <header>
                    <button name="action_confirm_paid"
                            string="Payer"
                            type="object"
                            class="oe_highlight"
                            invisible="is_paid"/>

                    <button name="action_set_unpaid"
                            string="Non payé"
                            type="object"
                            invisible="not is_paid"/>

                    <field name="is_paid" widget="boolean_button"
                        options="{'terminology': 'paid'}"
                        invisible="1"/>
                </header>

                <sheet>

                    <!-- ================= TITLE ================= -->
                    <div class="oe_title">
                        <h1>
                            <field name="date" class="oe_inline"/>
                        </h1>
                    </div>

                    <!-- ================= GENERAL INFO ================= -->
                    <group string="Trip Information">
                        <group>
                            <field name="driver_remorque_id"/>
                            <field name="client_id"/>
                            <label for="going_price"/>
                            <div class="o_row">
                                <field name="going_price"/>
                                <field name="is_going_price_unpaid" widget="boolean_toggle" nolabel="1"/>
                            </div>
                        </group>
                        <group>
                            <field name="destination"/>
                            <label for="returning_price"/>
                            <div class="o_row">
                                <field name="returning_price"/>
                                <field name="is_returning_price_unpaid" widget="boolean_toggle" nolabel="1"/>
                            </div>
                        </group>
                    </group>

                    <!-- ================= CHARGES ================= -->
                    <group string="Charges">
                        <group>
                            <label for="charge_fuel"/>
                            <div class="o_row">
                                <field name="charge_fuel"/>
                                <field name="is_charge_fuel_unpaid" widget="boolean_toggle" nolabel="1"/>
                            </div>
                            <label for="charge_driver"/>
                            <div class="o_row">
                                <field name="charge_driver"/>
                                <field name="is_charge_driver_unpaid" widget="boolean_toggle" nolabel="1"/>
                            </div>
                            <field name="charge_adblue"/>
                            <field name="charge_mixed"/>
                            <field name="note" invisible="charge_mixed == 0" required="charge_mixed &gt; 0"/>
                        </group>
                    </group>

                    <!-- ================= TOTAL ================= -->
                    <group string="Summary">
                        <group>
                            <field name="total_amount"
                                readonly="1"
                                class="oe_inline"
                                widget="monetary"/>
                            <field name="total_price"/>
                            <field name="profit"/>
                        </group>
                    </group>

                    <!-- ================= COMMENTS ================= -->
                    <group string="Comment">
                        <field name="note" placeholder="Spécifier les détailles des charges mixes"/>
                    </group>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>


    <!-- Tree View -->
    <record id="view_transport_trip_remorque_tree" model="ir.ui.view">
        <field name="name">transport.trip.remorque.tree</field>
        <field name="model">transport.trip.remorque</field>
        <field name="arch" type="xml">
            <tree string="Transport Trips Remorque" decoration-success="is_paid" decoration-info="is_checked" default_order="date desc, id desc">
                <field name="is_checked" widget="boolean_toggle"/>
                <field name="date"/>
                <field name="driver_remorque_id"/>
                <field name="client_id"/>
                <field name="destination"/>
                <field name="going_price"/>
                <field name="returning_price"/>
                <field name="total_price"/>
                <field name="charge_fuel"/>
                <field name="charge_driver"/>
                <field name="charge_adblue"/>
                <field name="charge_mixed"/>
                <field name="total_amount" sum="Total charges"/>
                <field name="profit" sum="Bénéfice"/>
                <field name="create_date" string="Date de création" optional="show"/>
                <field name="is_paid" widget="boolean_toggle" decoration-success="is_paid" decoration-danger="not is_paid"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_transport_trip_remorque_search" model="ir.ui.view">
        <field name="name">transport.trip.remorque.search</field>
        <field name="model">transport.trip.remorque</field>
        <field name="arch" type="xml">
            <search string="Search Transport Trips Remorque">
                <field name="driver_remorque_id"/>
                <field name="client_id"/>
                <field name="destination"/>
                <field name="date"/>
                
                <filter string="Paid" name="paid" domain="[('is_paid', '=', True)]"/>
                <filter string="Unpaid" name="unpaid" domain="[('is_paid', '=', False)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Driver" name="group_driver" domain="[]" context="{'group_by': 'driver_remorque_id'}"/>
                    <filter string="Client" name="group_client" domain="[]" context="{'group_by': 'client_id'}"/>
                    <filter string="Destination" name="group_dest" domain="[]" context="{'group_by': 'destination'}"/>
                    <filter string="Date de Voyage" name="group_date" domain="[]" context="{'group_by': 'date:day'}"/>
                    <filter string="Date de Création (Jour)" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_transport_trip_remorque_pivot" model="ir.ui.view">
        <field name="name">transport.trip.remorque.pivot</field>
        <field name="model">transport.trip.remorque</field>
        <field name="arch" type="xml">
            <pivot string="Transport Analysis Remorque">
                <field name="date" type="row" interval="day"/>
                <field name="client_id" type="row"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_transport_trip_remorque_graph" model="ir.ui.view">
        <field name="name">transport.trip.remorque.graph</field>
        <field name="model">transport.trip.remorque</field>
        <field name="arch" type="xml">
            <graph string="Transport Analysis Remorque" type="bar">
                <field name="date" type="row" interval="day"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_transport_trip_remorque" model="ir.actions.act_window">
        <field name="name">Transport Trips Remorque</field>
        <field name="res_model">transport.trip.remorque</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="context">{'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transport trip remorque!
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_transport_trip_remorque" name="Trips Remorque" parent="menu_transport_operations" action="action_transport_trip_remorque" sequence="2" groups="group_transport_viewer,group_transport_user,group_transport_manager"/>

</odoo>
