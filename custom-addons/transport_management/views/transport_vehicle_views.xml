<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_transport_vehicle_tree" model="ir.ui.view">
        <field name="name">transport.vehicle.tree</field>
        <field name="model">transport.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Véhicules">
                <field name="name"/>
                <field name="matricule"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_transport_vehicle_form" model="ir.ui.view">
        <field name="name">transport.vehicle.form</field>
        <field name="model">transport.vehicle</field>
        <field name="arch" type="xml">
            <form string="Véhicule">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom du véhicule (ex: Camion 1)..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="matricule"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historique des Voyages (Classiques)">
                            <field name="trip_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="driver_id"/>
                                    <field name="client_id"/>
                                    <field name="total_price"/>
                                    <field name="profit"/>
                                    <field name="is_paid" widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Historique Remorque">
                            <field name="trip_remorque_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="driver_remorque_id"/>
                                    <field name="client_id"/>
                                    <field name="total_price"/>
                                    <field name="profit"/>
                                    <field name="is_paid" widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_transport_vehicle" model="ir.actions.act_window">
        <field name="name">Véhicules</field>
        <field name="res_model">transport.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <!-- Menu -->
    <menuitem id="menu_transport_vehicle"
            name="Véhicules"
            parent="menu_transport_data"
            action="action_transport_vehicle"
            sequence="40"/>
</odoo>
