<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Paiement -->
    <record id="view_tresorerie_paiement_tree" model="ir.ui.view">
        <field name="name">tresorerie.paiement.tree</field>
        <field name="model">tresorerie.paiement</field>
        <field name="arch" type="xml">
            <tree string="Paiements">
                <field name="date"/>
                <field name="client_id"/>
                <field name="amount" sum="Total"/>
                <field name="payment_type"/>
                <field name="check_date" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Paiement -->
    <record id="view_tresorerie_paiement_form" model="ir.ui.view">
        <field name="name">tresorerie.paiement.form</field>
        <field name="model">tresorerie.paiement</field>
        <field name="arch" type="xml">
            <form string="Paiement">
                <sheet>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="payment_type"/>
                            <field name="check_date" 
                                   required="payment_type == 'cheque'" 
                                   invisible="payment_type != 'cheque'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View to easily find payments -->
    <record id="view_tresorerie_paiement_search" model="ir.ui.view">
        <field name="name">tresorerie.paiement.search</field>
        <field name="model">tresorerie.paiement</field>
        <field name="arch" type="xml">
            <search string="Recherche Paiements">
                <field name="client_id"/>
                <field name="payment_type"/>
                <filter string="Chèques" name="type_cheque" domain="[('payment_type', '=', 'cheque')]"/>
                <filter string="Espèces" name="type_especes" domain="[('payment_type', '=', 'especes')]"/>
                <group expand="0" string="Group By">
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Type de paiement" name="group_type" context="{'group_by': 'payment_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Paiement -->
    <record id="action_tresorerie_paiement" model="ir.actions.act_window">
        <field name="name">Paiements</field>
        <field name="res_model">tresorerie.paiement</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enregistrer un nouveau paiement
            </p>
        </field>
    </record>

    <!-- Menu for Paiement under Paiements -->
    <menuitem id="menu_tresorerie_paiement_action" 
              name="Paiements" 
              parent="menu_tresorerie_paiements" 
              action="action_tresorerie_paiement" 
              sequence="10"/>

</odoo>
