<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================
         Tree View
    ==================================================================== -->
    <record id="view_tresorerie_sortie_tree" model="ir.ui.view">
        <field name="name">tresorerie.sortie.tree</field>
        <field name="model">tresorerie.sortie</field>
        <field name="arch" type="xml">
            <tree string="Sorties" decoration-muted="state == 'draft'"
                  decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="date"/>
                <field name="payment_type"/>
                <field name="client_id" optional="show"/>
                <field name="amount" sum="Total sorties (MAD)"/>
                <field name="state"
                       decoration-warning="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ===================================================================
         Form View
    ==================================================================== -->
    <record id="view_tresorerie_sortie_form" model="ir.ui.view">
        <field name="name">tresorerie.sortie.form</field>
        <field name="model">tresorerie.sortie</field>
        <field name="arch" type="xml">
            <form string="Sortie Trésorerie">

                <!-- Status bar -->
                <header>
                    <button name="action_confirm"
                            string="Confirmer"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_draft"
                            string="Remettre en brouillon"
                            type="object"
                            groups="tresorerie.group_tresorerie_manager"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <!-- Reference + date header -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Balance information banners -->
                    <div class="alert alert-info" role="alert"
                         style="margin-bottom:12px;">
                        <strong>Solde disponible trésorerie :</strong>
                        <field name="tresorerie_balance" readonly="1"
                               widget="monetary"
                               options="{'currency_field': False}"
                               nolabel="1"/>
                        <span> MAD</span>
                    </div>

                    <div class="alert alert-warning" role="alert"
                         style="margin-bottom:12px;"
                         invisible="payment_type != 'cheque' or not client_id">
                        <strong>Solde chèques disponible pour ce client :</strong>
                        <field name="client_cheque_balance" readonly="1"
                               widget="monetary"
                               options="{'currency_field': False}"
                               nolabel="1"/>
                        <span> MAD</span>
                    </div>

                    <group>
                        <group string="Mode de paiement">
                            <!-- Payment type — shown as radio buttons for clarity -->
                            <field name="payment_type" widget="radio"
                                   readonly="state == 'confirmed'"/>

                            <!-- Client — only for cheque, domain filtered dynamically -->
                            <field name="client_id"
                                   invisible="payment_type != 'cheque'"
                                   required="payment_type == 'cheque'"
                                   readonly="state == 'confirmed'"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"
                                   domain="[('paiement_ids.payment_type', '=', 'cheque'),
                                            ('paiement_ids.check_date', '&lt;=', context_today())]"/>
                        </group>
                        <group string="Détails">
                            <field name="amount"
                                   readonly="state == 'confirmed'"/>
                            <field name="date"
                                   readonly="state == 'confirmed'"/>
                        </group>
                    </group>

                    <group>
                        <field name="note"
                               placeholder="Motif / référence du paiement…"
                               readonly="state == 'confirmed'"
                               colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================================
         Search View
    ==================================================================== -->
    <record id="view_tresorerie_sortie_search" model="ir.ui.view">
        <field name="name">tresorerie.sortie.search</field>
        <field name="model">tresorerie.sortie</field>
        <field name="arch" type="xml">
            <search string="Recherche Sorties">
                <field name="name"/>
                <field name="client_id"/>
                <!-- Quick filters -->
                <filter string="Brouillon"    name="draft"     domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmé"     name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Espèces"      name="especes"   domain="[('payment_type', '=', 'especes')]"/>
                <filter string="Chèque"       name="cheque"    domain="[('payment_type', '=', 'cheque')]"/>
                <separator/>
                <filter string="Sorties du jour" name="today"
                        domain="[('date', '=', context_today())]"/>
                <!-- Group by -->
                <group expand="0" string="Regrouper par">
                    <filter string="Mode de paiement" name="grp_type"
                            context="{'group_by': 'payment_type'}"/>
                    <filter string="Client"            name="grp_client"
                            context="{'group_by': 'client_id'}"/>
                    <filter string="Date"              name="grp_date"
                            context="{'group_by': 'date'}"/>
                    <filter string="État"              name="grp_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================================================================
         Action
    ==================================================================== -->
    <record id="action_tresorerie_sortie" model="ir.actions.act_window">
        <field name="name">Sorties</field>
        <field name="res_model">tresorerie.sortie</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enregistrer une nouvelle sortie de trésorerie
            </p>
        </field>
    </record>

    <!-- ===================================================================
         Menu item
    ==================================================================== -->
    <menuitem id="menu_tresorerie_sortie_action"
              name="Sorties"
              parent="menu_tresorerie_paiements"
              action="action_tresorerie_sortie"
              sequence="20"/>

</odoo>
