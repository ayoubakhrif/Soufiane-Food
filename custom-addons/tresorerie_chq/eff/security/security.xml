<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Catégorie pour le module Trésorerie Chèques &amp; Effets -->
        <record id="module_category_tresorerie_chq" model="ir.module.category">
            <field name="name">Trésorerie Chèques &amp; Effets</field>
            <field name="description">Accès pour le module Trésorerie Chèques &amp; Effets</field>
            <field name="sequence">101</field>
        </record>

        <!-- Groupe Utilisateur -->
        <record id="group_tresorerie_chq_user" model="res.groups">
            <field name="name">Utilisateur (Chèques &amp; Effets)</field>
            <field name="category_id" ref="module_category_tresorerie_chq"/>
        </record>

        <!-- Groupe Responsable -->
        <record id="group_tresorerie_chq_manager" model="res.groups">
            <field name="name">Responsable (Chèques &amp; Effets)</field>
            <field name="category_id" ref="module_category_tresorerie_chq"/>
            <field name="implied_ids" eval="[(4, ref('group_tresorerie_chq_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Séquence pour les références de sorties -->
        <record id="seq_tresorerie_chq_sortie" model="ir.sequence">
            <field name="name">Trésorerie Chq/Eff - Sortie</field>
            <field name="code">tresorerie_chq.sortie</field>
            <field name="prefix">TSOR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
