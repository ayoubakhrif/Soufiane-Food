    <!-- =================================================================
         Menus
    ================================================================= -->
    <!-- Sous Mouvements -->
    <menuitem id="menu_tresorerie_chq_blacklist_client" 
              name="Liste Noire Clients" 
              parent="menu_tresorerie_chq_paiements" 
              action="action_tresorerie_chq_blacklist_client" 
              sequence="50"/>

