    <!-- Sous Configurations -->
    <menuitem id="menu_tresorerie_chq_blacklist_config" 
              name="Paramètres Liste Noire" 
              parent="menu_tresorerie_chq_donnees" 
              action="action_open_blacklist_config" 
              sequence="90"/>

</odoo>
