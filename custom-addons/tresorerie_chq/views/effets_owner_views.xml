<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================
         Tree View
    ================================================================= -->
    <record id="view_tresorerie_chq_effets_owner_tree" model="ir.ui.view">
        <field name="name">tresorerie_chq.effets.owner.tree</field>
        <field name="model">tresorerie_chq.effets.owner</field>
        <field name="arch" type="xml">
            <tree string="Porteurs de Chèques / Effets">
                <field name="name"/>
                <field name="cheque_count" string="Chèques"/>
                <field name="effet_count" string="Effets"/>
                <field name="cin" optional="show"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <!-- =================================================================
         Form View
    ================================================================= -->
    <record id="view_tresorerie_chq_effets_owner_form" model="ir.ui.view">
        <field name="name">tresorerie_chq.effets.owner.form</field>
        <field name="model">tresorerie_chq.effets.owner</field>
        <field name="arch" type="xml">
            <form string="Porteur de Chèque / Effet">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="cin"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Remarques…"/>
                    </group>
                    <notebook>
                        <page string="Chèques">
                            <field name="cheque_line_ids" readonly="1">
                                <tree>
                                    <field name="note" string="Numéro"/>
                                    <field name="check_date" string="Date d'échéance"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="bank_id"/>
                                    <field name="client_id"/>
                                    <field name="state" decoration-success="state == 'validated'" decoration-info="state == 'draft'" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Effets">
                            <field name="effet_line_ids" readonly="1">
                                <tree>
                                    <field name="note" string="Numéro"/>
                                    <field name="check_date" string="Date d'échéance"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="bank_id"/>
                                    <field name="client_id"/>
                                    <field name="state" decoration-success="state == 'validated'" decoration-info="state == 'draft'" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =================================================================
         Action + Menu (under Configurations)
    ================================================================= -->
    <record id="action_tresorerie_chq_effets_owner" model="ir.actions.act_window">
        <field name="name">Porteurs de Chèques / Effets</field>
        <field name="res_model">tresorerie_chq.effets.owner</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajouter un nouveau porteur de chèque / effet
            </p>
        </field>
    </record>

    <menuitem id="menu_tresorerie_chq_effets_owner"
              name="Porteurs de Chèques"
              parent="menu_tresorerie_chq_donnees"
              action="action_tresorerie_chq_effets_owner"
              sequence="20"/>

</odoo>
