<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Paiement -->
    <record id="view_tresorerie_chq_paiement_tree" model="ir.ui.view">
        <field name="name">tresorerie_chq.paiement.tree</field>
        <field name="model">tresorerie_chq.paiement</field>
        <field name="arch" type="xml">
            <tree string="Entrées" decoration-info="payment_type in ['cheque', 'effet']">
                <field name="date"/>
                <field name="client_id"/>
                <field name="payment_type"/>
                <field name="amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Paiement -->
    <record id="view_tresorerie_chq_paiement_form" model="ir.ui.view">
        <field name="name">tresorerie_chq.paiement.form</field>
        <field name="model">tresorerie_chq.paiement</field>
        <field name="arch" type="xml">
            <form string="Entrée Trésorerie">
                <header>
                    <button name="action_validate" type="object" string="Valider" class="oe_highlight" invisible="state == 'validated'"/>
                    <button name="action_draft" type="object" string="Remettre en brouillon" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"/>
                </header>
                <sheet>
                    <group>
                        <group string="Informations générales">
                            <field name="client_id" readonly="state == 'validated'"/>
                            <field name="date" readonly="state == 'validated'"/>
                            <field name="reception_date" readonly="state == 'validated'"/>
                            <field name="payment_type" widget="radio" readonly="state == 'validated'"/>
                            <field name="scan_document_name" invisible="1"/>
                            <field name="scan_document" string="Scan du document" filename="scan_document_name" widget="binary"/>
                            <button name="action_parse_pdf_via_ai" type="object" string="Analyser le document (IA)" class="btn-primary" icon="fa-robot" invisible="not scan_document" help="Extrait automatiquement les chèques ou effets à partir du PDF scanné."/>
                            <button name="action_confirm_ai_data" type="object" string="Confirmer les données IA" class="btn-secondary" icon="fa-check" invisible="not scan_document" help="Enregistre les corrections pour améliorer l'IA lors des prochains entraînements."/>
                        </group>
                        <group string="Montant">
                             <!-- Computed read-only total -->
                            <field name="amount"
                                   string="Total (MAD)"
                                   readonly="1"/>
                            <field name="is_soufiane" invisible="1"/>
                        </group>
                    </group>

                     <!-- Separate Notebook Pages for Chèques and Effets -->
                    <notebook>
                        <!-- Page for Chèques -->
                        <page string="Chèques" name="cheque_lines" invisible="payment_type != 'cheque'">
                            <field name="cheque_line_ids" context="{'default_reception_date': reception_date}" readonly="state == 'validated'">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="owner_id"
                                           string="Porteur"
                                           optional="show"
                                           options="{'no_quick_create': False, 'no_create_edit': False}"
                                           placeholder="— Client —"/>

                                    <field name="core_ste_id" options="{'no_create': True}" optional="show"/>
                                    <field name="reception_date" optional="show"/>
                                    <field name="allow_no_date" column_invisible="True"/>
                                    <field name="check_date"
                                           string="Date d'échéance"
                                           optional="show"/>
                                    <field name="amount"
                                           string="Montant (MAD)"
                                           sum="Total"/>
                                    <field name="note"
                                           string="N° chèque"
                                           optional="show"/>
                                    <field name="bank_id"
                                           string="Banque"
                                           options="{'no_create_edit': True, 'no_quick_create': True}"
                                           optional="show"/>
                                    <field name="state"
                                           string="État"
                                           readonly="1"
                                           widget="badge"
                                           decoration-info="state == 'stock'"
                                           decoration-warning="state in ['remis', 'banque']"
                                           decoration-success="state == 'encaisse'"
                                           decoration-danger="state == 'impaye'"/>
                                </tree>
                            </field>
                            <group>
                                <field name="amount"
                                       string="Total (MAD)"
                                       readonly="1"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>

                        <!-- Page for Effets -->
                        <page string="Effets" name="effet_lines" invisible="payment_type != 'effet'">
                            <field name="effet_line_ids" context="{'default_reception_date': reception_date}" readonly="state == 'validated'">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="owner_id"
                                           string="Porteur"
                                           optional="show"
                                           options="{'no_quick_create': False, 'no_create_edit': False}"
                                           placeholder="— Client —"/>

                                    <field name="core_ste_id" options="{'no_create': True}" optional="show"/>
                                    <field name="reception_date" optional="show"/>
                                    <field name="allow_no_date" column_invisible="True"/>
                                    <field name="check_date"
                                           string="Date d'échéance"
                                           optional="show"/>
                                    <field name="amount"
                                           string="Montant (MAD)"
                                           sum="Total"/>
                                    <field name="note"
                                           string="N° effet"
                                           optional="show"/>
                                    <field name="bank_id"
                                           string="Banque"
                                           options="{'no_create_edit': True, 'no_quick_create': True}"
                                           optional="show"/>
                                    <field name="state"
                                           string="État"
                                           readonly="1"
                                           widget="badge"
                                           decoration-info="state == 'stock'"
                                           decoration-warning="state in ['remis', 'banque']"
                                           decoration-success="state == 'encaisse'"
                                           decoration-danger="state == 'impaye'"/>
                                </tree>
                            </field>
                            <group>
                                <field name="amount"
                                       string="Total (MAD)"
                                       readonly="1"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tresorerie_chq_paiement_search" model="ir.ui.view">
        <field name="name">tresorerie_chq.paiement.search</field>
        <field name="model">tresorerie_chq.paiement</field>
        <field name="arch" type="xml">
            <search string="Recherche Entrées">
                <field name="client_id"/>
                <field name="payment_type"/>
                <filter string="Chèques" name="type_cheque"
                        domain="[('payment_type', '=', 'cheque')]"/>
                <filter string="Effets" name="type_effet"
                        domain="[('payment_type', '=', 'effet')]"/>
                <group expand="0" string="Group By">
                    <filter string="Client"
                            name="group_client"
                            context="{'group_by': 'client_id'}"/>
                    <filter string="Type de paiement"
                            name="group_type"
                            context="{'group_by': 'payment_type'}"/>
                    <filter string="Mois"
                            name="group_date_month"
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Jour"
                            name="group_date_day"
                            context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Paiement -->
    <record id="action_tresorerie_chq_paiement" model="ir.actions.act_window">
        <field name="name">Entrées (Chèques &amp; Effets)</field>
        <field name="res_model">tresorerie_chq.paiement</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_date_month': 1, 'search_default_group_date_day': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enregistrer un nouveau paiement par chèque ou effet
            </p>
        </field>
    </record>

    <!-- Menu for Paiement under Mouvements -->
    <menuitem id="menu_tresorerie_chq_paiement_action"
              name="Entrées"
              parent="menu_tresorerie_chq_paiements"
              action="action_tresorerie_chq_paiement"
              sequence="10"/>
</odoo>
